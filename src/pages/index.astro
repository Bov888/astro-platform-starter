---
import KanbanBoard from '../components/KanbanBoard.jsx';
import WeatherWidget from '../components/WeatherWidget.astro';
---

<html lang="uk" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Сімейний Хаб</title>
  </head>
  <body class="h-full bg-slate-900 text-slate-100 flex flex-col font-sans antialiased overflow-hidden">
    
    <!-- Хедера панель -->
    <header class="flex-shrink-0 bg-slate-800/80 border-b border-slate-700/60 px-6 py-4 flex items-center justify-between backdrop-blur-md">
      <div class="flex items-center gap-3">
        <span class="text-2xl">🏡</span>
        <h1 class="text-lg font-bold tracking-tight text-white">Сімейний Хаб</h1>
      </div>
      <WeatherWidget />
    </header>

    <!-- Головна робоча зона (Kanban по пріоритетах) -->
    <main class="flex-1 min-h-0 p-6 overflow-hidden flex flex-col">
      <div class="mb-4 flex items-center justify-between flex-shrink-0">
        <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-wider">Управління задачами за пріоритетами</h2>
      </div>
      
      <div class="flex-1 min-h-0">
        <KanbanBoard client:load />
      </div>
    </main>

  </body>
</html>
