/ вид "Список": найближчі 7 днів зі справами, прострочені зверху /
let calMode=localStorage.wp_calmode==='list'?'list':'month';
const fmtShort=d=>new Date(d+'T12:00').toLocaleDateString('uk-UA',{weekday:'short',day:'numeric',month:'short'});
const dayMonth=d=>new Date(d+'T12:00').toLocaleDateString('uk-UA',{day:'numeric',month:'long'});
const kindName=t=>t.kind==='in'?'Хатня':(PROFILES[t.profile]?.n||'Вулична');
function agRow(t,over){
  const i=taskInfo(t);
  const meta=over?${fmtShort(t.date)} · ${kindName(t)} · ${t.duration} год:t.kind==='in'?${kindName(t)} · ${t.duration} год:${kindName(t)} · ${t.duration} год · ${i.txt};
  const cls=over||t.kind==='in'?'in':i.c;
  return ``+
    ${esc(t.title)}${meta};
}
function renderAgenda(){
  if(calMode!=='list')return;
  const P=PROFILES[pf];
  const days=[...Array(7).keys()].map(n=>{const d=new Date(today+'T12:00');d.setDate(d.getDate()+n);return d.toLocaleDateString('en-CA')});
  const over=tasks.filter(t=>!t.done&&t.datea.dateПрострочені${over.length}${over.map(t=>agRow(t,true)).join('')}`;
  for(const ds of days){
    const list=tasks.filter(t=>t.date===ds&&!t.done),inf=dayInfo(ds),w=win(ds,pf,2);
    const sw=w.st==null?'прогнозу ще немає':w.st>0?rng(w.r):'вікон немає';
    h+=${ds===today?'Сьогодні, '+dayMonth(ds):fmtDate(ds)}+
       ${inf?wIcon(wxKind(ds,inf))+' '+Math.round(inf.tmax)+'° · ':''}${P.n}: ${sw}+
       (list.length?list.map(t=>agRow(t,false)).join(''):'Справ немає')+``;
  }
  $('#agenda').innerHTML=h;
}
