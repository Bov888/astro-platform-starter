---
// Детальний запит погоди з прогнозом на 7 днів (для координат Карпатського регіону / Косівщини)
let weather = { location: "Карпати", temp: "—", condition: "Завантаження...", wind: "—", daily: [] };
try {
  const weatherRes = await fetch("https://api.open-meteo.com/v1/forecast?latitude=48.31&longitude=25.09&current=temperature_2m,weather_code,wind_speed_10m&daily=weather_code,temperature_2m_max,temperature_2m_min&timezone=auto");
  const data = await weatherRes.json();
  
  if (data && data.current) {
    // Проста інтерпретація кодів погоди WMO
    const getWeatherDesc = (code) => {
      if (code === 0) return "Ясно ☀️";
      if (code <= 3) return "Мінлива хмарність ⛅";
      if (code <= 48) return "Туман 🌫️";
      if (code <= 67) return "Дощ 🌧️";
      if (code <= 77) return "Сніг ❄️";
      return "Змінна погода 🌦️";
    };

    const dailyForecast = [];
    if (data.daily && data.daily.time) {
      const daysOfWeek = ['Нд', 'Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб'];
      for (let i = 0; i < data.daily.time.length; i++) {
        const dateObj = new Date(data.daily.time[i]);
        dailyForecast.push({
          day: i === 0 ? 'Сьогодні' : daysOfWeek[dateObj.getDay()],
          max: Math.round(data.daily.temperature_2m_max[i]),
          min: Math.round(data.daily.temperature_2m_min[i]),
          desc: getWeatherDesc(data.daily.weather_code[i])
        });
      }
    }

    weather = {
      location: "Карпати",
      temp: `${Math.round(data.current.temperature_2m)}°C`,
      condition: getWeatherDesc(data.current.weather_code),
      wind: `${data.current.wind_speed_10m} м/с`,
      daily: dailyForecast
    };
  }
} catch (e) {
  console.error("Помилка завантаження погоди:", e);
}

const familyTasks = [
  { id: 1, assignee: "Антоніна", task: "Підготувати малюнки до школи", status: "в процесі" },
  { id: 2, assignee: "Дружина", task: "Узгодити зустріч по клієнтах", status: "виконано" },
  { id: 3, assignee: "Всі", task: "Перевірити стан інструментів", status: "план" }
];

const upcomingEvents = [
  { date: "Сьогодні, 18:00", title: "Розмова з волонтером (ENGin)" },
  { date: "Завтра", title: "Планування тижня" }
];
---

<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Мій Хаб</title>
    <style>
      body {
        font-family: system-ui, -apple-system, sans-serif;
        background-color: #0f172a;
        color: #f1f5f9;
        margin: 0;
        padding: 16px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
      }
      .card {
        background-color: #1e293b;
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 16px;
      }
      h1 { font-size: 24px; margin: 0 0 4px 0; color: #fff; }
      h2 { font-size: 16px; margin: 0 0 12px 0; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; }
      
      /* Фільтри */
      .filters {
        display: flex;
        gap: 6px;
        margin-bottom: 12px;
        overflow-x: auto;
        padding-bottom: 4px;
      }
      .filter-btn {
        background: #0f172a;
        border: 1px solid #334155;
        color: #94a3b8;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 12px;
        cursor: pointer;
        white-space: nowrap;
      }
      .filter-btn.active {
        background: #2563eb;
        color: #fff;
        border-color: #2563eb;
      }

      .task-item, .event-item {
        background: #0f172a;
        padding: 10px 12px;
        border-radius: 8px;
        margin-bottom: 8px;
        border: 1px solid #1e293b;
      }
      .badge {
        font-size: 11px;
        padding: 2px 6px;
        border-radius: 4px;
        font-weight: bold;
      }
      .badge-orange { background: #78350f; color: #fde68a; }
      .badge-green { background: #064e3b; color: #a7f3d0; }
      .badge-blue { background: #1e3a8a; color: #bfdbfe; }
      
      /* Погода */
      .weather-current {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
        padding-bottom: 12px;
        border-bottom: 1px solid #334155;
      }
      .temp { font-size: 32px; font-weight: bold; color: #38bdf8; }
      
      .forecast-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
        text-align: center;
      }
      .forecast-day {
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 8px 4px;
      }
      .forecast-day-name { font-size: 11px; color: #94a3b8; margin-bottom: 4px; }
      .forecast-temps { font-size: 12px; font-weight: bold; margin-top: 4px; }
      .temp-max { color: #f87171; }
      .temp-min { color: #60a5fa; }

      input[type="text"] {
        width: 100%;
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 10px;
        color: #fff;
        box-sizing: border-box;
        margin-bottom: 8px;
      }
      button.save-btn {
        background: #2563eb;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 10px 16px;
        font-weight: bold;
        width: 100%;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <div class="container">
      
      <!-- Шапка -->
      <div style="margin-bottom: 20px;">
        <h1>Мій Хаб</h1>
        <p style="color: #94a3b8; font-size: 14px; margin: 0;">Оперативний центр</p>
      </div>

      <!-- Погода: поточна + прогноз на 7 днів -->
      <div class="card">
        <h2>🌤️ Погода • {weather.location}</h2>
        
        <div class="weather-current">
          <div>
            <div style="font-size: 16px; font-weight: 600; color: #fff;">{weather.condition}</div>
            <div style="font-size: 13px; color: #94a3b8; margin-top: 2px;">Вітер: {weather.wind}</div>
          </div>
          <div class="temp">{weather.temp}</div>
        </div>

        <!-- 7 днів прогнозу -->
        <div class="forecast-grid">
          {weather.daily.map(day => (
            <div class="forecast-day">
              <div class="forecast-day-name">{day.day}</div>
              <div style="font-size: 14px;" title={day.desc}>
                {day.desc.includes('☀️') ? '☀️' : day.desc.includes('⛅') ? '⛅' : day.desc.includes('🌧️') ? '🌧️' : '🌥️'}
              </div>
              <div class="forecast-temps">
                <span class="temp-max">{day.max}°</span>
                <span style="color: #64748b; font-weight: normal;">/</span>
                <span class="temp-min">{day.min}°</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Сімейні задачі з фільтрами -->
      <div class="card">
        <h2>👥 Сімейні задачі</h2>
        
        <div class="filters">
          <button class="filter-btn active" data-filter="all">Усі</button>
          <button class="filter-btn" data-filter="в процесі">В процесі</button>
          <button class="filter-btn" data-filter="план">План</button>
          <button class="filter-btn" data-filter="виконано">Виконано</button>
        </div>

        <div id="tasks-list">
          {familyTasks.map(item => (
            <div class="task-item" data-status={item.status}>
              <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                <span class="badge badge-orange">{item.assignee}</span>
                <span class="badge badge-blue">{item.status}</span>
              </div>
              <div style="font-size: 14px; font-weight: 500;">{item.task}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Події -->
      <div class="card">
        <h2>📅 Події</h2>
        {upcomingEvents.map(event => (
          <div class="event-item">
            <div style="font-size: 12px; color: #38bdf8; margin-bottom: 2px;">{event.date}</div>
            <div style="font-size: 14px; font-weight: 500;">{event.title}</div>
          </div>
        ))}
      </div>

      <!-- Швидка нотатка -->
      <div class="card">
        <h2>💡 Швидка нотатка</h2>
        <input type="text" id="note-input" placeholder="Введіть думку або посилання..." />
        <button class="save-btn" id="save-note">Зберегти</button>
      </div>

    </div>

    <script>
      // Фільтрація завдань
      const filterButtons = document.querySelectorAll('.filter-btn');
      const taskItems = document.querySelectorAll('.task-item');

      filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          filterButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          
          const filter = btn.getAttribute('data-filter');
          taskItems.forEach(item => {
            const status = item.getAttribute('data-status');
            if (filter === 'all' || status === filter) {
              item.style.display = 'block';
            } else {
              item.style.display = 'none';
            }
          });
        });
      });

      // Збереження нотатки
      const saveBtn = document.getElementById('save-note');
      const noteInput = document.getElementById('note-input') as HTMLInputElement;

      saveBtn?.addEventListener('click', () => {
        if (!noteInput || !noteInput.value.trim()) return;
        alert('Нотатку збережено: ' + noteInput.value);
        noteInput.value = '';
      });
    </script>
  </body>
</html>
