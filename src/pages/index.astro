---
// Динамічне завантаження погоди для Карпатського регіону
let weather = { location: "Карпати", temp: "—", condition: "Завантаження...", wind: "—" };
try {
  const weatherRes = await fetch("https://api.open-meteo.com/v1/forecast?latitude=48.31&longitude=25.09&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m");
  const weatherData = await weatherRes.json();
  if (weatherData && weatherData.current) {
    weather = {
      location: "Карпати",
      temp: `${Math.round(weatherData.current.temperature_2m)}°C`,
      condition: "Мінлива хмарність",
      wind: `${weatherData.current.wind_speed_10m} м/с`
    };
  }
} catch (e) {
  console.error("Помилка погоди:", e);
}

const familyTasks = [
  { id: 1, assignee: "Антоніна", task: "Підготувати малюнки до школи", status: "в процесі" },
  { id: 2, assignee: "Дружина", task: "Узгодити зустріч по клієнтах", status: "виконано" },
  { id: 3, assignee: "Всі", task: "Перевірити стан інструментів", status: "план" }
];

const upcomingEvents = [
  { date: "Сьогодні, 18:00", title: "Розмова з волонтером (ENGin)" },
  { date: "Завтра", title: "Планування тижня" }
];
---

<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Мій Хаб • Оперативний центр</title>
    <style>
      /* Гарантовані стилі сітки на всю ширину, що не залежать від збірки Tailwind */
      body {
        background-color: #111827;
        color: #e5e7eb;
        font-family: system-ui, -apple-system, sans-serif;
        margin: 0;
        padding: 20px;
      }
      .hub-container {
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
      }
      .hub-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
      }
      @media (max-width: 1024px) {
        .hub-grid {
          grid-template-columns: 1fr;
        }
      }
      .card {
        background-color: #1f2937;
        border: 1px solid #374151;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.3);
      }
      .col-span-2 {
        grid-column: span 2;
      }
      @media (max-width: 1024px) {
        .col-span-2 {
          grid-column: span 1;
        }
      }
      .weather-mini-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid #374151;
      }
      .weather-day {
        background: rgba(17, 24, 39, 0.4);
        text-align: center;
        padding: 6px 2px;
        border-radius: 10px;
        font-size: 11px;
      }
      .task-row {
        background: rgba(17, 24, 39, 0.5);
        border: 1px solid rgba(55, 65, 81, 0.4);
        padding: 14px;
        border-radius: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
      }
      .badge {
        font-size: 10px;
        font-weight: bold;
        padding: 2px 8px;
        border-radius: 6px;
        display: inline-block;
        margin-bottom: 4px;
      }
      .btn {
        background: #2563eb;
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 10px;
        cursor: pointer;
        font-weight: 500;
      }
      .btn:hover {
        background: #1d4ed8;
      }
    </style>
  </head>
  <body>
    
    <div class="hub-container">
      
      <!-- Шапка -->
      <header style="margin-bottom: 24px; padding-left: 8px;">
        <h1 style="font-size: 28px; font-weight: 800; margin: 0; color: #ffffff;">Мій Хаб</h1>
        <p style="color: #9ca3af; font-size: 14px; margin: 4px 0 0 0;">Оперативний центр</p>
      </header>

      <!-- Сітка дашборду на всю ширину -->
      <div class="hub-grid">
        
        <!-- БЛОК 1: ПОГОДА -->
        <section class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
              <span style="font-size: 20px;">⛅</span>
              <h2 style="font-size: 11px; font-weight: bold; text-transform: uppercase; color: #9ca3af; margin: 0;">Погода • {weather.location}</h2>
            </div>
            
            <div style="display: flex; align-items: baseline; justify-content: between; margin-bottom: 16px;">
              <div>
                <div style="font-size: 18px; font-weight: bold; color: white;">{weather.condition} ⛅</div>
                <div style="font-size: 12px; color: #9ca3af; margin-top: 2px;">Вітер: {weather.wind}</div>
              </div>
              <div style="font-size: 36px; font-weight: 900; color: white; margin-left: auto;">{weather.temp}</div>
            </div>

            <!-- Міні-прогноз на тиждень -->
            <div class="weather-mini-grid">
              <div class="weather-day"><div style="color: #9ca3af; margin-bottom: 2px;">Сьогодні</div><div>⛅</div><div style="font-weight: 600; margin-top: 2px;">18°</div></div>
              <div class="weather-day"><div style="color: #9ca3af; margin-bottom: 2px;">Нд</div><div>⛅</div><div style="font-weight: 600; margin-top: 2px;">18°</div></div>
              <div class="weather-day"><div style="color: #9ca3af; margin-bottom: 2px;">Пн</div><div>⛅</div><div style="font-weight: 600; margin-top: 2px;">18°</div></div>
              <div class="weather-day"><div style="color: #9ca3af; margin-bottom: 2px;">Вт</div><div>⛅</div><div style="font-weight: 600; margin-top: 2px;">16°</div></div>
              <div class="weather-day"><div style="color: #9ca3af; margin-bottom: 2px;">Ср</div><div>⛅</div><div style="font-weight: 600; margin-top: 2px;">17°</div></div>
              <div class="weather-day"><div style="color: #9ca3af; margin-bottom: 2px;">Чт</div><div>⛅</div><div style="font-weight: 600; margin-top: 2px;">16°</div></div>
              <div class="weather-day"><div style="color: #9ca3af; margin-bottom: 2px;">Пт</div><div>🌧️</div><div style="font-weight: 600; margin-top: 2px;">12°</div></div>
            </div>
          </div>
        </section>

        <!-- БЛОК 2: СІМЕЙНІ ЗАДАЧІ (на 2 колонки) -->
        <section class="card col-span-2" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="font-size: 20px;">👥</span>
                <h2 style="font-size: 11px; font-weight: bold; text-transform: uppercase; color: #9ca3af; margin: 0;">Сімейні задачі</h2>
              </div>
              
              <!-- Фільтри -->
              <div style="display: flex; gap: 4px; background: rgba(17, 24, 39, 0.6); padding: 4px; border-radius: 10px; font-size: 12px;" id="filter-container">
                <button class="filter-btn" data-filter="all" style="background: #2563eb; color: white; border: none; padding: 4px 12px; border-radius: 8px; cursor: pointer;">Усі</button>
                <button class="filter-btn" data-filter="в процесі" style="background: transparent; color: #9ca3af; border: none; padding: 4px 12px; border-radius: 8px; cursor: pointer;">В процесі</button>
                <button class="filter-btn" data-filter="план" style="background: transparent; color: #9ca3af; border: none; padding: 4px 12px; border-radius: 8px; cursor: pointer;">План</button>
                <button class="filter-btn" data-filter="виконано" style="background: transparent; color: #9ca3af; border: none; padding: 4px 12px; border-radius: 8px; cursor: pointer;">Виконано</button>
              </div>
            </div>

            <!-- Список завдань -->
            <div id="tasks-list">
              {familyTasks.map(item => (
                <div class="task-row" data-status={item.status}>
                  <div>
                    <span class="badge" style="background: rgba(245, 158, 11, 0.2); color: #fcd34d;">{item.assignee}</span>
                    <div style="font-size: 14px; font-weight: 500; color: white;">{item.task}</div>
                  </div>
                  <span style="font-size: 12px; padding: 4px 10px; background: rgba(59, 130, 246, 0.2); color: #60a5fa; border-radius: 8px; font-weight: 500;">{item.status}</span>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- БЛОК 3: ПОДІЇ -->
        <section class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 16px;">
              <span style="font-size: 20px;">📅</span>
              <h2 style="font-size: 11px; font-weight: bold; text-transform: uppercase; color: #9ca3af; margin: 0;">Найближчі події</h2>
            </div>
            <div style="display: flex; flex-direction: column; gap: 10px;">
              {upcomingEvents.map(event => (
                <div style="background: rgba(17, 24, 39, 0.5); border: 1px solid rgba(55, 65, 81, 0.4); padding: 12px; border-radius: 12px;">
                  <div style="font-size: 11px; color: #38bdf8; font-weight: 600; margin-bottom: 4px;">{event.date}</div>
                  <div style="font-size: 14px; font-weight: 500; color: white;">{event.title}</div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- БЛОК 4: ШВИДКА НОТАТКА (на 2 колонки) -->
        <section class="card col-span-2" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
              <span style="font-size: 20px;">💡</span>
              <h2 style="font-size: 11px; font-weight: bold; text-transform: uppercase; color: #9ca3af; margin: 0;">Швидка нотатка / Думка</h2>
            </div>
            <div style="display: flex; flex-direction: column; gap: 10px;">
              <input 
                type="text" 
                id="note-input" 
                placeholder="Введіть думку, посилання чи ідею..." 
                style="width: 100%; box-sizing: border-box; background: rgba(17, 24, 39, 0.7); border: 1px solid #374151; border-radius: 12px; padding: 12px 16px; font-size: 14px; color: white; outline: none;"
              />
              <button id="save-note" class="btn" style="width: 100%;">
                Зберегти нотатку
              </button>
            </div>
          </div>
        </section>

      </div>
    </div>

    <script>
      const filterButtons = document.querySelectorAll('.filter-btn');
      const taskItems = document.querySelectorAll('.task-row');

      filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          filterButtons.forEach(b => {
            (b as HTMLElement).style.background = 'transparent';
            (b as HTMLElement).style.color = '#9ca3af';
          });
          (btn as HTMLElement).style.background = '#2563eb';
          (btn as HTMLElement).style.color = 'white';
          
          const filter = btn.getAttribute('data-filter');
          taskItems.forEach(item => {
            const status = item.getAttribute('data-status');
            if (filter === 'all' || status === filter) {
              (item as HTMLElement).style.display = 'flex';
            } else {
              (item as HTMLElement).style.display = 'none';
            }
          });
        });
      });

      const saveBtn = document.getElementById('save-note');
      const noteInput = document.getElementById('note-input') as HTMLInputElement;

      saveBtn?.addEventListener('click', () => {
        if (!noteInput || !noteInput.value.trim()) return;
        alert('Нотатку успішно збережено: ' + noteInput.value);
        noteInput.value = '';
      });
    </script>
  </body>
</html>
