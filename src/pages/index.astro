/ вид і категорія родинних задач: зберігаються тут, у родинній дошці нічого не міняється /
let famMeta={};
async function metaLoad(){
  famMeta=JSON.parse(localStorage.wp_fmeta||'{}');
  if(!sb)return;
  const r=await sb.from('wp_family_meta').select('*');
  if(r.error){note('Категорії родинних задач: '+r.error.message+' (беру локальні)');return}
  famMeta=Object.fromEntries(r.data.map(x=>[x.task_id,{kind:x.kind,profile:x.profile}]));
}
async function metaSet(id,p){
  famMeta[id]=Object.assign(famMeta[id]||{},p);
  if(sb){
    const r=await sb.from('wp_family_meta').upsert({task_id:Number(id),kind:famMeta[id].kind||null,profile:famMeta[id].profile||null});
    if(r.error){note(r.error.message);localStorage.wp_fmeta=JSON.stringify(famMeta)}
  }else localStorage.wp_fmeta=JSON.stringify(famMeta);
}

/ родинна дошка: окремий клієнт Supabase, лише читання /
let fsb=null,fsbId='',famTasks=[],famState={mode:'off',msg:''};
const FS={todo:'До виконання',doing:'В роботі'};
async function famLoad(){
  famTasks=[];
  if(!(cfg.furl&&cfg.fkey)){fsb=null;fsbId='';famState={mode:'off',msg:''};return}
  if(!window.supabase){famState={mode:'err',msg:'бібліотека Supabase не завантажилась'};return}
  const id=cfg.furl+'|'+cfg.fkey;
  if(id!==fsbId){fsb=supabase.createClient(cfg.furl,cfg.fkey,{auth:{storageKey:'wp-family-auth'}});fsbId=id}
  try{
    const {data:{session}}=await fsb.auth.getSession();
    if(!session){famState={mode:'login',msg:''};return}
    const r=await fsb.from('family_tasks').select('*').eq('person',cfg.fperson).neq('status','done').order('priority').order('id');
    if(r.error){famState={mode:'err',msg:r.error.message};return}
    famTasks=r.data;famState={mode:'ok',msg:''};
  }catch(e){famState={mode:'err',msg:String(e.message||e)}}
}
function famInfo(){
  const m=famState.mode;
  if(m==='login')return ' Родинна дошка: виконай вхід нижче.';
  if(m==='ok')return  Родинна дошка: задач для «${cfg.fperson}»: ${famTasks.length}.;
  if(m==='err')return  Родинна дошка: помилка (${famState.msg}).;
  return '';
}
function famHtml(){
  const m=famState.mode;if(m==='off')return '';
  const h=З родинної дошки (лише перегляд);
  if(m==='login')return h+'Щоб бачити задачі, увійди в налаштуваннях (шестірня, розділ «Вхід у родинну дошку»).';
  if(m==='err')return h+Не вдалося завантажити: ${esc(famState.msg)};
  if(!famTasks.length)return h+Відкритих задач для «${esc(cfg.fperson)}» немає.;
  return h+famTasks.map(t=>{
    const m=famMeta[t.id]||{},p=m.profile||pf;
    const i=m.kind?taskInfo({kind:m.kind,profile:p,date:sel,duration:1}):null;
    return ${esc(t.text)}${FS[t.status]||esc(t.status)}+
      Вид…${kindOpts(m.kind)}+
      (m.kind==='out'?${profOpts(p)}:'')+``+
      (i?${i.txt}:'')+``;
  }).join('');
}

let dbState={mode:'local',msg:''};
async function dbLoad(){
  dbState={mode:'local',msg:''};
  if(cfg.url&&cfg.key&&!window.supabase)dbState={mode:'err',msg:'бібліотека Supabase не завантажилась'};
  if(sb){
    try{
      const r=await sb.from('wp_tasks').select('*').order('date');
      if(!r.error){tasks=r.data;dbState={mode:'sb',msg:''};return}
      dbState={mode:'err',msg:r.error.message};
    }catch(e){dbState={mode:'err',msg:String(e.message||e)}}
    note('Supabase: '+dbState.msg+'. Працюю локально.');sb=null;
  }
  tasks=JSON.parse(localStorage.wp_tasks||'[]');
}
function renderDb(){
  const e=$('#db'),m=dbState.mode;
  e.className='chip '+(m==='sb'?'ok':m==='err'?'bad':'');
  e.textContent=m==='sb'?'Supabase':m==='err'?'Помилка бази':'Локально';
  e.title=m==='err'?dbState.msg:m==='sb'?'Справи зберігаються в Supabase':'Справи зберігаються лише в цьому браузері';
}
const lsSave=()=>{if(!sb)localStorage.wp_tasks=JSON.stringify(tasks)};
async function dbAdd(t){
  if(sb){const r=await sb.from('wp_tasks').insert(t).select().single();if(r.error)return note(r.error.message);tasks.push(r.data)}
  else{t.id=Math.max(Date.now(),...tasks.map(x=>Number(x.id)||0))+1;tasks.push(t);lsSave()}
  return true;
}
async function dbSet(id,p){
  const t=tasks.find(x=>x.id==id);Object.assign(t,p);
  if(sb){const r=await sb.from('wp_tasks').update(p).eq('id',id);if(r.error)note(r.error.message)}else lsSave();
}
async function dbDel(id){
  tasks=tasks.filter(x=>x.id!=id);
  if(sb){const r=await sb.from('wp_tasks').delete().eq('id',id);if(r.error)note(r.error.message)}else lsSave();
}

