---
---

<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Родинний Дашборд</title>
    <style>
      :root {
        --bg-color: #090d16;
        --card-bg: #111827;
        --card-border: #1f2937;
        --text-main: #f3f4f6;
        --text-muted: #9ca3af;
        --accent: #6366f1;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }

      body {
        background-color: var(--bg-color);
        color: var(--text-main);
        min-height: 100vh;
        padding: 16px;
      }

      header {
        margin-bottom: 24px;
        text-align: left;
      }

      header h1 {
        font-size: 1.5rem;
        font-weight: 800;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      header p {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-top: 4px;
      }

      .dashboard-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
      }

      @media (min-width: 1024px) {
        .dashboard-grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      .card {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        display: flex;
        flex-direction: column;
        height: fit-content;
      }

      .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--card-border);
      }

      .card-title {
        font-size: 1.1rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .task-form {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-bottom: 16px;
        background: rgba(0, 0, 0, 0.2);
        padding: 12px;
        border-radius: 12px;
        border: 1px solid var(--card-border);
      }

      .task-form input,
      .task-form select {
        background: #1f2937;
        border: 1px solid #374151;
        color: #fff;
        padding: 8px 12px;
        border-radius: 8px;
        font-size: 0.85rem;
        width: 100%;
      }

      .btn {
        background: var(--accent);
        color: #fff;
        border: none;
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 0.85rem;
        transition: background 0.2s;
      }

      .btn:hover {
        background: #4f46e5;
      }

      .tasks-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-height: 450px;
        overflow-y: auto;
      }

      .task-item {
        background: rgba(17, 24, 39, 0.6);
        border: 1px solid var(--card-border);
        padding: 12px;
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .task-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 8px;
      }

      .task-name {
        font-size: 0.9rem;
        font-weight: 600;
        color: #f3f4f6;
      }

      .badge {
        font-size: 0.7rem;
        padding: 2px 8px;
        border-radius: 6px;
        font-weight: 700;
        text-transform: uppercase;
      }

      .badge-high {
        background: rgba(244, 63, 94, 0.15);
        color: #fb7185;
        border: 1px solid rgba(244, 63, 94, 0.3);
      }

      .badge-medium {
        background: rgba(245, 158, 11, 0.15);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.3);
      }

      .badge-low {
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.3);
      }

      .task-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.75rem;
        color: var(--text-muted);
      }

      .assignee {
        color: #818cf8;
        font-weight: 600;
        background: rgba(99, 102, 241, 0.1);
        padding: 2px 6px;
        border-radius: 4px;
      }

      textarea.notes-area {
        width: 100%;
        height: 250px;
        background: #1f2937;
        border: 1px solid #374151;
        color: #fff;
        padding: 12px;
        border-radius: 10px;
        font-size: 0.9rem;
        resize: vertical;
        line-height: 1.5;
      }

      .save-status {
        font-size: 0.75rem;
        color: #34d399;
        margin-top: 6px;
        height: 16px;
      }

      .weather-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        max-height: 480px;
        overflow-y: auto;
      }

      .weather-row {
        background: rgba(17, 24, 39, 0.6);
        border: 1px solid var(--card-border);
        padding: 10px 12px;
        border-radius: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .weather-day {
        font-weight: 600;
        font-size: 0.85rem;
      }

      .weather-cond {
        font-size: 0.75rem;
        color: var(--text-muted);
      }

      .weather-right {
        text-align: right;
      }

      .temp {
        font-weight: 700;
        font-size: 0.85rem;
        color: #38bdf8;
      }

      .sun-time {
        font-size: 0.75rem;
        color: #fbbf24;
        margin-top: 2px;
      }
    </style>
  </head>

  <body>
    <header>
      <h1><span>🏡</span> Родинний Дашборд</h1>
      <p>Керування завданнями, нотатками та погодою</p>
    </header>

    <main class="dashboard-grid">
      <section class="card">
        <div class="card-header">
          <div class="card-title" style="color: #818cf8;"><span>📋</span> Сімейні задачі</div>
        </div>

        <form id="taskForm" class="task-form">
          <input type="text" id="taskTitle" placeholder="Нова задача..." required />
          <select id="taskAssignee">
            <option value="Олександр">Олександр</option>
            <option value="Людмила">Людмила</option>
            <option value="Максим">Максим</option>
            <option value="Антоніна">Антоніна</option>
          </select>
          <div style="display: flex; gap: 8px;">
            <select id="taskPriority">
              <option value="Високий">Високий</option>
              <option value="Середній" selected>Середній</option>
              <option value="Низький">Низький</option>
            </select>
            <select id="taskStatus">
              <option value="План">План</option>
              <option value="В процесі">В процесі</option>
              <option value="Виконано">Виконано</option>
            </select>
          </div>
          <button type="submit" class="btn">Додати задачу</button>
        </form>

        <div id="tasksList" class="tasks-list"></div>
      </section>

      <section class="card">
        <div class="card-header">
          <div class="card-title" style="color: #fbbf24;"><span>📝</span> Швидкі нотатки</div>
        </div>
        <div style="flex: 1; display: flex; flex-direction: column;">
          <textarea id="quickNotes" class="notes-area" placeholder="Пишіть сюди..." aria-label="Швидкі нотатки"></textarea>
          <div id="saveStatus" class="save-status"></div>
        </div>
      </section>

      <section class="card">
        <div class="card-header">
          <div class="card-title" style="color: #38bdf8;"><span>⛅</span> Погода у Карпатах</div>
          <span style="font-size: 0.7rem; background: rgba(56,189,248,0.1); color: #38bdf8; padding: 2px 8px; border-radius: 6px;">
            7 днів
          </span>
        </div>

        <div class="weather-list">
          <div class="weather-row">
            <div>
              <div class="weather-day">Сьогодні (Сб)</div>
              <div class="weather-cond">Сонячно</div>
            </div>
            <div class="weather-right">
              <div class="temp">+18° / +10°</div>
              <div class="sun-time">🌅 06:15 🌇 19:12</div>
            </div>
          </div>

          <div class="weather-row">
            <div>
              <div class="weather-day">Неділя</div>
              <div class="weather-cond">Змінна хмарність</div>
            </div>
            <div class="weather-right">
              <div class="temp">+16° / +9°</div>
              <div class="sun-time">🌅 06:17 🌇 19:10</div>
            </div>
          </div>

          <div class="weather-row">
            <div>
              <div class="weather-day">Понеділок</div>
              <div class="weather-cond">Невеликий дощ</div>
            </div>
            <div class="weather-right">
              <div class="temp">+15° / +8°</div>
              <div class="sun-time">🌅 06:18 🌇 19:08</div>
            </div>
          </div>

          <div class="weather-row">
            <div>
              <div class="weather-day">Вівторок</div>
              <div class="weather-cond">Хмарно</div>
            </div>
            <div class="weather-right">
              <div class="temp">+17° / +9°</div>
              <div class="sun-time">🌅 06:20 🌇 19:06</div>
            </div>
          </div>

          <div class="weather-row">
            <div>
              <div class="weather-day">Середа</div>
              <div class="weather-cond">Ясно</div>
            </div>
            <div class="weather-right">
              <div class="temp">+19° / +11°</div>
              <div class="sun-time">🌅 06:22 🌇 19:04</div>
            </div>
          </div>

          <div class="weather-row">
            <div>
              <div class="weather-day">Четвер</div>
              <div class="weather-cond">Сонячно</div>
            </div>
            <div class="weather-right">
              <div class="temp">+18° / +10°</div>
              <div class="sun-time">🌅 06:23 🌇 19:02</div>
            </div>
          </div>

          <div class="weather-row">
            <div>
              <div class="weather-day">П'ятниця</div>
              <div class="weather-cond">Хмарно</div>
            </div>
            <div class="weather-right">
              <div class="temp">+16° / +9°</div>
              <div class="sun-time">🌅 06:25 🌇 19:00</div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <script>
      const defaultNote = `📌 План на тиждень:
- Перевірити стан ділянки та компостну яму
- Організувати закупівлю продуктів
- Підтвердити час на секції для дитини
- Підготувати список покупок для вихідних`;

      let tasks = [];
      const tasksListEl = document.getElementById('tasksList');
      const taskForm = document.getElementById('taskForm');
      const notesArea = document.getElementById('quickNotes');
      const saveStatus = document.getElementById('saveStatus');
      let saveTimer;

      function getPriorityClass(priority) {
        if (priority === 'Високий') return 'badge-high';
        if (priority === 'Середній') return 'badge-medium';
        return 'badge-low';
      }

      function renderTasks() {
        tasksListEl.innerHTML = '';

        tasks.forEach((task, index) => {
          const div = document.createElement('div');
          div.className = 'task-item';

          div.innerHTML = `
            <div class="task-top">
              <span class="task-name">${task.title}</span>
              <span class="badge ${getPriorityClass(task.priority)}">${task.priority}</span>
            </div>
            <div class="task-footer">
              <span class="assignee">👤 ${task.assignee}</span>
              <div style="display: flex; gap