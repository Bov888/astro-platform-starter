---
// 1. Динамічне завантаження погоди для Карпатського регіону
let weather = { location: "Карпати", temp: "—", condition: "Завантаження...", wind: "—" };
try {
  const weatherRes = await fetch("https://api.open-meteo.com/v1/forecast?latitude=48.31&longitude=25.09&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m");
  const weatherData = await weatherRes.json();
  if (weatherData && weatherData.current) {
    weather = {
      location: "Карпати",
      temp: `${Math.round(weatherData.current.temperature_2m)}°C`,
      condition: weatherData.current.temperature_2m > 0 ? "Мінлива хмарність" : "Прохолодно",
      wind: `${weatherData.current.wind_speed_10m} м/с`
    };
  }
} catch (e) {
  console.error("Помилка погоди:", e);
}

// 2. Початкові сімейні задачі
const familyTasks = [
  { id: 1, assignee: "Антоніна", task: "Підготувати малюнки до школи", status: "в процесі" },
  { id: 2, assignee: "Дружина", task: "Узгодити зустріч по клієнтах", status: "виконано" },
  { id: 3, assignee: "Всі", task: "Перевірити стан інструментів", status: "план" }
];

const upcomingEvents = [
  { date: "Сьогодні, 18:00", title: "Розмова з волонтером (ENGin)" },
  { date: "Завтра", title: "Планування тижня" }
];
---

<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Мій Хаб • Оперативний центр</title>
    <style>
      /* Додаткові дрібні стилі для плавних переходів фільтрів */
      .task-item {
        transition: all 0.2s ease-in-out;
      }
    </style>
  </head>
  <body class="bg-gray-900 text-gray-200 min-h-screen p-4 md:p-6 font-sans antialiased">
    
    <!-- Головний контейнер на всю ширину екрана з обмеженням 1600px -->
    <main class="max-w-[1600px] mx-auto">
      
      <!-- Шапка -->
      <header class="mb-6 px-2">
        <h1 class="text-3xl font-extrabold text-white tracking-tight">Мій Хаб</h1>
        <p class="text-gray-400 text-sm">Оперативний центр</p>
      </header>

      <!-- Сітка дашборду на всю ширину (3 колонки на ноутбуках) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- БЛОК 1: ПОГОДА (1 колонка) -->
        <section class="bg-gray-800 p-5 rounded-2xl border border-gray-700/60 shadow-lg flex flex-col justify-between">
          <div>
            <div class="flex items-center space-x-2 mb-3">
              <span class="text-xl">⛅</span>
              <h2 class="text-xs font-bold uppercase tracking-wider text-gray-400">Погода • {weather.location}</h2>
            </div>
            
            <div class="flex items-baseline justify-between mb-4">
              <div>
                <div class="text-xl font-bold text-white">{weather.condition} ⛅</div>
                <div class="text-xs text-gray-400 mt-0.5">Вітер: {weather.wind}</div>
              </div>
              <div class="text-4xl font-black text-white">{weather.temp}</div>
            </div>

            <!-- Міні-прогноз на тиждень -->
            <div class="grid grid-cols-7 gap-1.5 pt-3 border-t border-gray-700/60">
              <div class="text-center bg-gray-900/40 p-1.5 rounded-xl">
                <div class="text-[10px] text-gray-400 mb-1">Сьогодні</div>
                <div class="text-sm">⛅</div>
                <div class="text-xs font-semibold mt-1">18°<span class="text-gray-500 font-normal">/9°</span></div>
              </div>
              <div class="text-center bg-gray-900/40 p-1.5 rounded-xl">
                <div class="text-[10px] text-gray-400 mb-1">Нд</div>
                <div class="text-sm">⛅</div>
                <div class="text-xs font-semibold mt-1">18°<span class="text-gray-500 font-normal">/7°</span></div>
              </div>
              <div class="text-center bg-gray-900/40 p-1.5 rounded-xl">
                <div class="text-[10px] text-gray-400 mb-1">Пн</div>
                <div class="text-sm">⛅</div>
                <div class="text-xs font-semibold mt-1">18°<span class="text-gray-500 font-normal">/9°</span></div>
              </div>
              <div class="text-center bg-gray-900/40 p-1.5 rounded-xl">
                <div class="text-[10px] text-gray-400 mb-1">Вт</div>
                <div class="text-sm">⛅</div>
                <div class="text-xs font-semibold mt-1">16°<span class="text-gray-500 font-normal">/10°</span></div>
              </div>
              <div class="text-center bg-gray-900/40 p-1.5 rounded-xl">
                <div class="text-[10px] text-gray-400 mb-1">Ср</div>
                <div class="text-sm">⛅</div>
                <div class="text-xs font-semibold mt-1">17°<span class="text-gray-500 font-normal">/9°</span></div>
              </div>
              <div class="text-center bg-gray-900/40 p-1.5 rounded-xl">
                <div class="text-[10px] text-gray-400 mb-1">Чт</div>
                <div class="text-sm">⛅</div>
                <div class="text-xs font-semibold mt-1">16°<span class="text-gray-500 font-normal">/6°</span></div>
              </div>
              <div class="text-center bg-gray-900/40 p-1.5 rounded-xl">
                <div class="text-[10px] text-gray-400 mb-1">Пт</div>
                <div class="text-sm">🌧️</div>
                <div class="text-xs font-semibold mt-1">12°<span class="text-gray-500 font-normal">/9°</span></div>
              </div>
            </div>
          </div>
        </section>

        <!-- БЛОК 2: СІМЕЙНІ ЗАДАЧІ (2 колонки) -->
        <section class="bg-gray-800 p-5 rounded-2xl border border-gray-700/60 shadow-lg lg:col-span-2 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center space-x-2">
                <span class="text-xl">👥</span>
                <h2 class="text-xs font-bold uppercase tracking-wider text-gray-400">Сімейні задачі</h2>
              </div>
              
              <!-- Фільтри -->
              <div class="flex space-x-1 bg-gray-900/60 p-1 rounded-xl text-xs" id="filter-container">
                <button class="filter-btn px-3 py-1 bg-blue-600 text-white rounded-lg font-medium shadow cursor-pointer" data-filter="all">Усі</button>
                <button class="filter-btn px-3 py-1 text-gray-400 hover:text-white transition cursor-pointer" data-filter="в процесі">В процесі</button>
                <button class="filter-btn px-3 py-1 text-gray-400 hover:text-white transition cursor-pointer" data-filter="план">План</button>
                <button class="filter-btn px-3 py-1 text-gray-400 hover:text-white transition cursor-pointer" data-filter="виконано">Виконано</button>
              </div>
            </div>

            <!-- Список завдань -->
            <div class="space-y-3" id="tasks-list">
              {familyTasks.map(item => (
                <div class="task-item bg-gray-900/50 p-4 rounded-xl border border-gray-700/40 flex items-center justify-between" data-status={item.status}>
                  <div>
                    <span class="inline-block px-2 py-0.5 bg-amber-500/20 text-amber-400 text-[10px] font-bold rounded mb-1">{item.assignee}</span>
                    <div class="text-sm font-medium text-white">{item.task}</div>
                  </div>
                  <span class="text-xs px-2.5 py-1 bg-blue-500/20 text-blue-400 rounded-lg font-medium">{item.status}</span>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- БЛОК 3: ПОДІЇ (1 колонка) -->
        <section class="bg-gray-800 p-5 rounded-2xl border border-gray-700/60 shadow-lg flex flex-col justify-between">
          <div>
            <div class="flex items-center space-x-2 mb-4">
              <span class="text-xl">📅</span>
              <h2 class="text-xs font-bold uppercase tracking-wider text-gray-400">Найближчі події</h2>
            </div>
            <div class="space-y-3">
              {upcomingEvents.map(event => (
                <div class="bg-gray-900/50 p-3.5 rounded-xl border border-gray-700/40">
                  <div class="text-[11px] text-sky-400 font-semibold mb-1">{event.date}</div>
                  <div class="text-sm font-medium text-white">{event.title}</div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- БЛОК 4: ШВИДКА НОТАТКА (2 колонки) -->
        <section class="bg-gray-800 p-5 rounded-2xl border border-gray-700/60 shadow-lg lg:col-span-2 flex flex-col justify-between">
          <div>
            <div class="flex items-center space-x-2 mb-3">
              <span class="text-xl">💡</span>
              <h2 class="text-xs font-bold uppercase tracking-wider text-gray-400">Швидка нотатка / Думка</h2>
            </div>
            <div class="space-y-3">
              <input 
                type="text" 
                id="note-input" 
                placeholder="Введіть думку, посилання чи ідею..." 
                class="w-full bg-gray-900/70 border border-gray-700 rounded-xl px-4 py-3 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 transition"
              />
              <button 
                id="save-note" 
                class="w-full bg-blue-600 hover:bg-blue-500 text-white font-medium py-2.5 px-4 rounded-xl text-sm transition shadow-md cursor-pointer"
              >
                Зберегти нотатку
              </button>
            </div>
          </div>
        </section>

      </div>
    </main>

    <!-- Клієнтський скрипт для інтерактиву -->
    <script>
      // 1. Фільтрація сімейних завдань
      const filterButtons = document.querySelectorAll('.filter-btn');
      const taskItems = document.querySelectorAll('.task-item');

      filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          filterButtons.forEach(b => {
            b.classList.remove('bg-blue-600', 'text-white', 'shadow');
            b.classList.add('text-gray-400');
          });
          btn.classList.add('bg-blue-600', 'text-white', 'shadow');
          btn.classList.remove('text-gray-400');
          
          const filter = btn.getAttribute('data-filter');
          taskItems.forEach(item => {
            const status = item.getAttribute('data-status');
            if (filter === 'all' || status === filter) {
              (item as HTMLElement).style.display = 'flex';
            } else {
              (item as HTMLElement).style.display = 'none';
            }
          });
        });
      });

      // 2. Логіка збереження швидкої нотатки
      const saveBtn = document.getElementById('save-note');
      const noteInput = document.getElementById('note-input') as HTMLInputElement;

      saveBtn?.addEventListener('click', () => {
        if (!noteInput || !noteInput.value.trim()) return;
        alert('Нотатку успішно збережено: ' + noteInput.value);
        noteInput.value = '';
      });
    </script>
  </body>
</html>
