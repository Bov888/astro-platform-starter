---
// 1. Динамічне завантаження погоди (наприклад, для Карпатського регіону / Косівщини)
let weather = { location: "Карпати", temp: "—", condition: "Завантаження...", wind: "—" };
try {
  // Координати приблизно для Косівського району
  const weatherRes = await fetch("https://api.open-meteo.com/v1/forecast?latitude=48.31&longitude=25.09&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m");
  const weatherData = await weatherRes.json();
  if (weatherData && weatherData.current) {
    weather = {
      location: "Карпати",
      temp: `${Math.round(weatherData.current.temperature_2m)}°C`,
      condition: weatherData.current.temperature_2m > 0 ? "Ясно / Хмарно" : "Прохолодно",
      wind: `${weatherData.current.wind_speed_10m} м/с`
    };
  }
} catch (e) {
  console.error("Помилка погоди:", e);
}

// 2. Статичні поки що задачі (сюди можна підставити ваш Google Apps Script для завдань)
const familyTasks = [
  { id: 1, assignee: "Антоніна", task: "Підготувати малюнки до школи", status: "в процесі" },
  { id: 2, assignee: "Дружина", task: "Узгодити зустріч по клієнтах", status: "виконано" },
  { id: 3, assignee: "Всі", task: "Перевірити стан інструментів", status: "план" }
];

const upcomingEvents = [
  { date: "Сьогодні, 18:00", title: "Розмова з волонтером (ENGin)" },
  { date: "Завтра", title: "Планування тижня" }
];
---

<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Мій Хаб</title>
    <style>
      body {
        font-family: system-ui, -apple-system, sans-serif;
        background-color: #0f172a;
        color: #f1f5f9;
        margin: 0;
        padding: 16px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
      }
      .card {
        background-color: #1e293b;
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 16px;
      }
      h1 { font-size: 24px; margin: 0 0 4px 0; color: #fff; }
      h2 { font-size: 16px; margin: 0 0 12px 0; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; }
      
      /* Фільтри */
      .filters {
        display: flex;
        gap: 6px;
        margin-bottom: 12px;
        overflow-x: auto;
        padding-bottom: 4px;
      }
      .filter-btn {
        background: #0f172a;
        border: 1px solid #334155;
        color: #94a3b8;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 12px;
        cursor: pointer;
        white-space: nowrap;
      }
      .filter-btn.active {
        background: #2563eb;
        color: #fff;
        border-color: #2563eb;
      }

      .task-item, .event-item {
        background: #0f172a;
        padding: 10px 12px;
        border-radius: 8px;
        margin-bottom: 8px;
        border: 1px solid #1e293b;
      }
      .badge {
        font-size: 11px;
        padding: 2px 6px;
        border-radius: 4px;
        font-weight: bold;
      }
      .badge-orange { background: #78350f; color: #fde68a; }
      .badge-green { background: #064e3b; color: #a7f3d0; }
      .badge-blue { background: #1e3a8a; color: #bfdbfe; }
      
      .weather-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .temp { font-size: 28px; font-weight: bold; color: #38bdf8; }

      input[type="text"] {
        width: 100%;
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 10px;
        color: #fff;
        box-sizing: border-box;
        margin-bottom: 8px;
      }
      button.save-btn {
        background: #2563eb;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 10px 16px;
        font-weight: bold;
        width: 100%;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <div class="container">
      
      <!-- Шапка -->
      <div style="margin-bottom: 20px;">
        <h1>Мій Хаб</h1>
        <p style="color: #94a3b8; font-size: 14px; margin: 0;">Оперативний центр</p>
      </div>

      <!-- Погода в реальному часі -->
      <div class="card weather-box">
        <div>
          <div style="font-size: 12px; color: #94a3b8; text-transform: uppercase;">Погода • {weather.location}</div>
          <div style="font-size: 14px; font-weight: 500; margin-top: 2px;">{weather.condition} (віт. {weather.wind})</div>
        </div>
        <div class="temp">{weather.temp}</div>
      </div>

      <!-- Сімейні задачі з інтерактивними фільтрами -->
      <div class="card">
        <h2>👥 Сімейні задачі</h2>
        
        <div class="filters" id="filter-container">
          <button class="filter-btn active" data-filter="all">Усі</button>
          <button class="filter-btn" data-filter="в процесі">В процесі</button>
          <button class="filter-btn" data-filter="план">План</button>
          <button class="filter-btn" data-filter="виконано">Виконано</button>
        </div>

        <div id="tasks-list">
          {familyTasks.map(item => (
            <div class="task-item" data-status={item.status}>
              <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                <span class="badge badge-orange">{item.assignee}</span>
                <span class="badge badge-blue">{item.status}</span>
              </div>
              <div style="font-size: 14px; font-weight: 500;">{item.task}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Події -->
      <div class="card">
        <h2>📅 Події</h2>
        {upcomingEvents.map(event => (
          <div class="event-item">
            <div style="font-size: 12px; color: #38bdf8; margin-bottom: 2px;">{event.date}</div>
            <div style="font-size: 14px; font-weight: 500;">{event.title}</div>
          </div>
        ))}
      </div>

      <!-- Швидка нотатка -->
      <div class="card">
        <h2>💡 Швидка нотатка</h2>
        <input type="text" id="note-input" placeholder="Введіть думку або посилання..." />
        <button class="save-btn" id="save-note">Зберегти</button>
      </div>

    </div>

    <!-- Клієнтський скрипт для роботи фільтрів та нотаток прямо в браузері -->
    <script>
      // Фільтрація завдань
      const filterButtons = document.querySelectorAll('.filter-btn');
      const taskItems = document.querySelectorAll('.task-item');

      filterButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          filterButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          
          const filter = btn.getAttribute('data-filter');
          taskItems.forEach(item => {
            const status = item.getAttribute('data-status');
            if (filter === 'all' || status === filter) {
              item.style.display = 'block';
            } else {
              item.style.display = 'none';
            }
          });
        });
      });

      // Збереження нотатки в локальне сховище браузера (або можна підключити хмару)
      const saveBtn = document.getElementById('save-note');
      const noteInput = document.getElementById('note-input') as HTMLInputElement;

      saveBtn?.addEventListener('click', () => {
        if (!noteInput || !noteInput.value.trim()) return;
        alert('Нотатку збережено: ' + noteInput.value);
        noteInput.value = '';
      });
    </script>
  </body>
</html>
