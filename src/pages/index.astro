---
// Приклад даних для сімейної дошки завдань
const familyTasks = [
  { id: 1, title: "Купити продукти на тиждень", assignee: "Олександр", priority: "Високий", status: "В процесі" },
  { id: 2, title: "Записати дитину на секцію", assignee: "Людмила", priority: "Середній", status: "Виконано" },
  { id: 3, title: "Зробити домашнє завдання з математики", assignee: "Максим", priority: "Високий", status: "План" },
  { id: 4, title: "Полити квіти та подбати про сад", assignee: "Антоніна", priority: "Низький", status: "План" },
];

// 7-денний прогноз погоди
const weatherForecast = [
  { day: "Субота", temp: "+18° / +10°", condition: "Сонячно", sunset: "19:12" },
  { day: "Неділя", temp: "+16° / +9°", condition: "Хмарно", sunset: "19:10" },
  { day: "Понеділок", temp: "+15° / +8°", condition: "Дощ", sunset: "19:08" },
  { day: "Вівторок", temp: "+17° / +9°", condition: "Змінна хмарність", sunset: "19:06" },
  { day: "Середа", temp: "+19° / +11°", condition: "Сонячно", sunset: "19:04" },
  { day: "Четвер", temp: "+18° / +10°", condition: "Сонячно", sunset: "19:02" },
  { day: "П'ятниця", temp: "+16° / +9°", condition: "Хмарно", sunset: "19:00" },
];
---

<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Сімейний Дашборд</title>
  </head>
  <body class="bg-slate-900 text-slate-100 min-h-screen p-4 md:p-8 font-sans">
    
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight">Родинний Дашборд</h1>
      <p class="text-slate-400 text-sm mt-1">Організація завдань, нотаток та погоди</p>
    </header>

    <!-- Головна сітка: рівні три колонки -->
    <main class="grid grid-cols-1 md:grid-cols-3 gap-6">

      <!-- КОЛОНКА 1: Задачі для родини -->
      <section class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-5 shadow-lg flex flex-col">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-semibold flex items-center gap-2">
            <span>📋</span> Сімейні задачі
          </h2>
          <span class="text-xs bg-indigo-500/20 text-indigo-300 px-2.5 py-1 rounded-full font-medium">Олександр, Людмила, Максим, Антоніна</span>
        </div>

        <div class="space-y-3 flex-1 overflow-y-auto max-h-[600px]">
          {familyTasks.map((task) => (
            <div class="bg-slate-900/50 border border-slate-700/40 p-3.5 rounded-lg hover:border-slate-600 transition-colors">
              <div class="flex justify-between items-start gap-2 mb-1">
                <h3 class="font-medium text-sm text-slate-200">{task.title}</h3>
                <span class={`text-[10px] px-2 py-0.5 rounded uppercase font-bold tracking-wider ${
                  task.priority === 'Високий' ? 'bg-red-500/20 text-red-400 border border-red-500/30' :
                  task.priority === 'Середній' ? 'bg-amber-500/20 text-amber-400 border border-amber-500/30' :
                  'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30'
                }`}>
                  {task.priority}
                </span>
              </div>
              <div class="flex justify-between items-center mt-3 text-xs text-slate-400">
                <span class="text-indigo-400 font-medium">👤 {task.assignee}</span>
                <span class={`px-2 py-0.5 rounded text-[11px] ${
                  task.status === 'Виконано' ? 'bg-green-500/10 text-green-400' :
                  task.status === 'В процесі' ? 'bg-blue-500/10 text-blue-400' :
                  'bg-slate-700/50 text-slate-300'
                }`}>
                  {task.status}
                </span>
              </div>
            </div>
          ))}
        </div>
      </section>


      <!-- КОЛОНКА 2: Нотатки -->
      <section class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-5 shadow-lg flex flex-col">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-semibold flex items-center gap-2">
            <span>📝</span> Швидкі нотатки
          </h2>
          <span class="text-xs bg-amber-500/20 text-amber-300 px-2.5 py-1 rounded-full font-medium">Локальні</span>
        </div>

        <div class="space-y-3 flex-1">
          <div class="bg-slate-900/50 border border-slate-700/40 p-3.5 rounded-lg">
            <h3 class="font-medium text-sm text-amber-300 mb-1">📌 План на тиждень</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Перевірити стан ділянки, підготувати матеріали для компостної ями та оновити списки в Anki для англійської.
            </p>
          </div>

          <div class="bg-slate-900/50 border border-slate-700/40 p-3.5 rounded-lg">
            <h3 class="font-medium text-sm text-indigo-300 mb-1">💡 Ідеї та покупки</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Замовити насіння костриці червоної, перевірити параметри паливної системи авто та налаштувати автоматизацію.
            </p>
          </div>
        </div>
      </section>


      <!-- КОЛОНКА 3: Погода та захід сонця (на 7 днів) -->
      <section class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-5 shadow-lg flex flex-col">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xl font-semibold flex items-center gap-2">
            <span>⛅</span> Погода на 7 днів
          </h2>
          <span class="text-xs bg-sky-500/20 text-sky-300 px-2.5 py-1 rounded-full font-medium">Карпати</span>
        </div>

        <div class="space-y-2.5 flex-1 overflow-y-auto max-h-[600px]">
          {weatherForecast.map((item) => (
            <div class="bg-slate-900/50 border border-slate-700/40 p-3 rounded-lg flex items-center justify-between">
              <div>
                <p class="font-medium text-sm text-slate-200">{item.day}</p>
                <p class="text-xs text-slate-400">{item.condition}</p>
              </div>
              <div class="text-right">
                <p class="text-sm font-semibold text-sky-400">{item.temp}</p>
                <p class="text-[11px] text-amber-400/90 flex items-center justify-end gap-1">
                  <span>🌅</span> {item.sunset}
                </p>
              </div>
            </div>
          ))}
        </div>
      </section>

    </main>

  </body>
</html>
