---
const familyTasks = [
  { assignee: "Антоніна", task: "Підготувати малюнки до школи", status: "в процесі" },
  { assignee: "Дружина", task: "Узгодити зустріч по клієнтах", status: "виконано" },
  { assignee: "Всі", task: "Перевірити стан інструментів", status: "план" }
];

const upcomingEvents = [
  { date: "Сьогодні, 18:00", title: "Розмова з волонтером (ENGin)" },
  { date: "Завтра", title: "Планування тижня" }
];
---

<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Мій Хаб</title>
    <style>
      body {
        font-family: system-ui, -apple-system, sans-serif;
        background-color: #0f172a;
        color: #f1f5f9;
        margin: 0;
        padding: 16px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
      }
      .card {
        background-color: #1e293b;
        border: 1px solid #334155;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 16px;
      }
      h1 { font-size: 24px; margin: 0 0 4px 0; color: #fff; }
      h2 { font-size: 16px; margin: 0 0 12px 0; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; }
      .task-item, .event-item {
        background: #0f172a;
        padding: 10px 12px;
        border-radius: 8px;
        margin-bottom: 8px;
        border: 1px solid #1e293b;
      }
      .badge {
        font-size: 11px;
        padding: 2px 6px;
        border-radius: 4px;
        font-weight: bold;
      }
      .badge-orange { background: #78350f; color: #fde68a; }
      .badge-green { background: #064e3b; color: #a7f3d0; }
      .badge-blue { background: #1e3a8a; color: #bfdbfe; }
      input[type="text"] {
        width: 100%;
        background: #0f172a;
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 10px;
        color: #fff;
        box-sizing: border-box;
        margin-bottom: 8px;
      }
      button {
        background: #2563eb;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 10px 16px;
        font-weight: bold;
        width: 100%;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <div class="container">
      
      <!-- Шапка -->
      <div style="margin-bottom: 20px;">
        <h1>Мій Хаб</h1>
        <p style="color: #94a3b8; font-size: 14px; margin: 0;">Оперативний центр</p>
      </div>

      <!-- Блок 1: Задачі для сім'ї -->
      <div class="card">
        <h2>👥 Сімейні задачі</h2>
        {familyTasks.map(item => (
          <div class="task-item">
            <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
              <span class="badge badge-orange">{item.assignee}</span>
              <span class="badge badge-blue">{item.status}</span>
            </div>
            <div style="font-size: 14px; font-weight: 500;">{item.task}</div>
          </div>
        ))}
      </div>

      <!-- Блок 2: Події -->
      <div class="card">
        <h2>📅 Події</h2>
        {upcomingEvents.map(event => (
          <div class="event-item">
            <div style="font-size: 12px; color: #38bdf8; margin-bottom: 2px;">{event.date}</div>
            <div style="font-size: 14px; font-weight: 500;">{event.title}</div>
          </div>
        ))}
      </div>

      <!-- Блок 3: Швидка нотатка -->
      <div class="card">
        <h2>💡 Швидка нотатка</h2>
        <input type="text" placeholder="Введіть думку або посилання..." />
        <button>Зберегти</button>
      </div>

    </div>
  </body>
</html>
