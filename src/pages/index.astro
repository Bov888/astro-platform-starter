---
const familyTasks = [
  { id: 1, title: "Купити продукти на тиждень", assignee: "Олександр", priority: "Високий", status: "В процесі" },
  { id: 2, title: "Записати дитину на секцію", assignee: "Людмила", priority: "Середній", status: "Виконано" },
  { id: 3, title: "Зробити домашнє завдання з математики", assignee: "Максим", priority: "Високий", status: "План" },
  { id: 4, title: "Полити квіти та подбати про сад", assignee: "Антоніна", priority: "Низький", status: "План" },
];

const weatherForecast = [
  { day: "Сьогодні", temp: "+18° / +10°", condition: "Сонячно", sunset: "19:12" },
  { day: "Неділя", temp: "+16° / +9°", condition: "Хмарно", sunset: "19:10" },
  { day: "Понеділок", temp: "+15° / +8°", condition: "Дощ", sunset: "19:08" },
  { day: "Вівторок", temp: "+17° / +9°", condition: "Змінна хмарність", sunset: "19:06" },
  { day: "Середа", temp: "+19° / +11°", condition: "Сонячно", sunset: "19:04" },
  { day: "Четвер", temp: "+18° / +10°", condition: "Сонячно", sunset: "19:02" },
  { day: "П'ятниця", temp: "+16° / +9°", condition: "Хмарно", sunset: "19:00" },
];
---

<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Родинний Дашборд</title>
    <!-- Підключаємо Tailwind CSS через CDN, щоб стилі гарантовано спрацювали на Netlify -->
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen p-3 sm:p-6 font-sans antialiased">
    
    <header class="mb-6 px-1">
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white flex items-center gap-2">
        <span>🏡</span> Родинний Дашборд
      </h1>
      <p class="text-slate-400 text-xs sm:text-sm mt-0.5">Оперативна інформація, задачі та погода</p>
    </header>

    <!-- Головна сітка: на мобільних в один стовпчик, на планшетах/ПК — 3 рівні колонки -->
    <main class="grid grid-cols-1 lg:grid-cols-3 gap-5">

      <!-- КОЛОНКА 1: Задачі для родини -->
      <section class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl flex flex-col">
        <div class="flex items-center justify-between mb-3 pb-2 border-b border-slate-800">
          <h2 class="text-base font-bold flex items-center gap-2 text-indigo-300">
            <span>📋</span> Сімейні задачі
          </h2>
          <span class="text-[10px] bg-indigo-500/10 text-indigo-400 px-2 py-0.5 rounded-full font-medium">Олександр, Людмила, Максим, Антоніна</span>
        </div>

        <div class="space-y-2.5">
          {familyTasks.map((task) => (
            <div class="bg-slate-950/60 border border-slate-800/80 p-3 rounded-xl hover:border-slate-700 transition-all">
              <div class="flex justify-between items-start gap-2 mb-1.5">
                <span class="font-semibold text-xs text-slate-100 leading-snug">{task.title}</span>
                <span class={`text-[9px] px-2 py-0.5 rounded-md font-bold uppercase tracking-wider shrink-0 ${
                  task.priority === 'Високий' ? 'bg-rose-500/15 text-rose-400 border border-rose-500/30' :
                  task.priority === 'Середній' ? 'bg-amber-500/15 text-amber-400 border border-amber-500/30' :
                  'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30'
                }`}>
                  {task.priority}
                </span>
              </div>
              <div class="flex justify-between items-center text-[11px] text-slate-400 pt-1">
                <span class="text-indigo-400 font-medium bg-indigo-950/40 px-2 py-0.5 rounded">👤 {task.assignee}</span>
                <span class={`px-2 py-0.5 rounded font-medium ${
                  task.status === 'Виконано' ? 'bg-emerald-500/10 text-emerald-400' :
                  task.status === 'В процесі' ? 'bg-blue-500/10 text-blue-400' :
                  'bg-slate-800 text-slate-300'
                }`}>
                  {task.status}
                </span>
              </div>
            </div>
          ))}
        </div>
      </section>


      <!-- КОЛОНКА 2: Нотатки -->
      <section class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl flex flex-col">
        <div class="flex items-center justify-between mb-3 pb-2 border-b border-slate-800">
          <h2 class="text-base font-bold flex items-center gap-2 text-amber-300">
            <span>📝</span> Нотатки
          </h2>
          <span class="text-[10px] bg-amber-500/10 text-amber-400 px-2 py-0.5 rounded-full font-medium">Швидкі записи</span>
        </div>

        <div class="space-y-3">
          <div class="bg-slate-950/60 border border-slate-800/80 p-3.5 rounded-xl">
            <h3 class="font-bold text-xs text-amber-300 mb-1 flex items-center gap-1.5">
              <span>📌</span> План на тиждень
            </h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Перевірити стан ділянки, підготувати матеріали для компостної ями та оновити списки в Anki для англійської.
            </p>
          </div>

          <div class="bg-slate-950/60 border border-slate-800/80 p-3.5 rounded-xl">
            <h3 class="font-bold text-xs text-indigo-300 mb-1 flex items-center gap-1.5">
              <span>💡</span> Ідеї та покупки
            </h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Замовити насіння костриці червоної, перевірити параметри паливної системи авто та налаштувати автоматизацію.
            </p>
          </div>
        </div>
      </section>


      <!-- КОЛОНКА 3: Погода та захід сонця (на 7 днів) -->
      <section class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl flex flex-col">
        <div class="flex items-center justify-between mb-3 pb-2 border-b border-slate-800">
          <h2 class="text-base font-bold flex items-center gap-2 text-sky-300">
            <span>⛅</span> Погода (7 днів)
          </h2>
          <span class="text-[10px] bg-sky-500/10 text-sky-400 px-2 py-0.5 rounded-full font-medium">Карпати</span>
        </div>

        <div class="space-y-2">
          {weatherForecast.map((item) => (
            <div class="bg-slate-950/60 border border-slate-800/80 px-3 py-2.5 rounded-xl flex items-center justify-between">
              <div>
                <p class="font-semibold text-xs text-slate-200">{item.day}</p>
                <p class="text-[11px] text-slate-400">{item.condition}</p>
              </div>
              <div class="text-right">
                <p class="text-xs font-bold text-sky-400">{item.temp}</p>
                <p class="text-[10px] text-amber-400 font-medium flex items-center justify-end gap-1 mt-0.5">
                  <span>🌅</span> {item.sunset}
                </p>
              </div>
            </div>
          ))}
        </div>
      </section>

    </main>

  </body>
</html>
