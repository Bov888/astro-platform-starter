---
/*
SQL для Supabase (виконати один раз у SQL Editor):

create table wp_tasks(
  id uuid primary key default gen_random_uuid(),
  title text not null,
  kind text not null default 'out',
  profile text,
  date date not null,
  duration int not null default 1,
  done boolean not null default false,
  created_at timestamptz default now()
);
alter table wp_tasks enable row level security;
create policy "anon all" on wp_tasks for all using (true) with check (true);
notify pgrst, 'reload schema';

Додатково: вид і категорія родинних задач (таблиця родинної дошки не змінюється):

create table if not exists wp_family_meta(
  task_id bigint primary key,
  kind text,
  profile text
);
alter table wp_family_meta enable row level security;
create policy "anon all" on wp_family_meta for all using (true) with check (true);
notify pgrst, 'reload schema';
*/
---
<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#edf2ef">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Literata:opsz,wght@7..72,500;7..72,600&family=Onest:wght@400;500;600&display=swap" rel="stylesheet">
<title>Погодний планувальник</title>

<script is:inline>
(function(){var t=localStorage.wp_theme||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.dataset.theme=t})();
</script>
<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js"></script>
<style is:global>
:root{color-scheme:light;--bg:#edf2ef;--card:#ffffff;--soft:#f4f7f5;--line:#dbe4df;--fg:#18271f;--mut:#5d6f68;--acc:#1c7a58;--on:#ffffff;--acc-soft:#dff1e8;--go:#2f9e77;--maybe:#d8921a;--no:#d4604a;--rain:#3f86d6;--sun:#e0991a;--sh:0 1px 2px rgba(20,50,38,.06),0 10px 28px rgba(20,50,38,.07);--font:"Onest",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;--serif:"Literata",Georgia,serif}
:root[data-theme=dark]{color-scheme:dark;--bg:#0f1614;--card:#17211e;--soft:#1c2825;--line:#2a3833;--fg:#e4ece8;--mut:#93a69e;--acc:#6fdcb0;--on:#0b2018;--acc-soft:#1f3a31;--go:#5cc9a0;--maybe:#e6bd55;--no:#ee826a;--rain:#7ab4f2;--sun:#f0b84a;--sh:none}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;min-height:100dvh;display:flex;flex-direction:column;gap:12px;background:var(--bg);color:var(--fg);font:15px/1.45 var(--font);padding:max(12px,env(safe-area-inset-top)) max(14px,env(safe-area-inset-right)) max(14px,env(safe-area-inset-bottom)) max(14px,env(safe-area-inset-left));overflow-x:hidden}
h1,h2,h3,p{margin:0}
button,select,input{font:inherit;color:inherit;background:var(--card);border:1px solid var(--line);border-radius:10px}
button{cursor:pointer;padding:6px 12px;min-height:36px}
button:hover:not(:disabled){border-color:var(--acc)}
button:disabled{opacity:.55;cursor:default}
input,select{min-height:38px;padding:7px 11px;max-width:100%;min-width:0}
input::placeholder{color:var(--mut);opacity:.8}
select{appearance:none;-webkit-appearance:none;padding-right:32px;text-overflow:ellipsis;cursor:pointer;background-image:linear-gradient(45deg,transparent 50%,var(--mut) 50%),linear-gradient(135deg,var(--mut) 50%,transparent 50%);background-position:calc(100% - 17px) 54%,calc(100% - 12px) 54%;background-size:5px 5px,5px 5px;background-repeat:no-repeat}
:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
.mut{color:var(--mut)}
.err{color:var(--no);font-size:13px}
.pri{background:var(--acc);border-color:var(--acc);color:var(--on);font-weight:600}
.pri:hover:not(:disabled){filter:brightness(1.08)}
.gh{background:transparent;font-size:13px;min-height:32px;padding:4px 11px}
.gh:hover:not(:disabled){color:var(--acc)}
.gh.dng:hover:not(:disabled){color:var(--no);border-color:var(--no)}
.ic{width:1em;height:1em;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}
summary{list-style:none}summary::-webkit-details-marker{display:none}
.ib{width:38px;height:38px;min-height:0;padding:0;display:inline-grid;place-items:center;border-radius:12px;cursor:pointer;border:1px solid var(--line);background:var(--card);color:var(--fg)}
.ib svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.ib:hover,details[open]>.ib{border-color:var(--acc);color:var(--acc)}

/* шапка */
.top{display:grid;grid-template-columns:auto minmax(0,1fr) auto;grid-template-areas:"brand bar right";align-items:center;gap:10px 18px;flex:none}
.brand{grid-area:brand;display:flex;align-items:center;gap:10px}
.logo{width:36px;height:36px;border-radius:12px;display:grid;place-items:center;background:var(--acc);color:var(--on)}
.logo svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
h1{font:600 20px/1.2 var(--serif)}
.bar{grid-area:bar;display:flex;align-items:center;gap:8px;flex-wrap:wrap;min-width:0}
.bar select{min-height:34px;padding-top:4px;padding-bottom:4px;font-weight:500}
#src{display:flex;gap:6px;flex-wrap:wrap}
.right{grid-area:right;display:flex;gap:8px;align-items:center}
#upd{font-size:13px}
#note{color:var(--no);font-size:13px;margin-top:-4px}
#note:empty{display:none}
.chip{--d:var(--mut);display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:500;min-height:28px;padding:2px 11px;border-radius:99px;background:var(--card);color:var(--fg);white-space:nowrap}
.chip::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--d)}
.chip:empty{display:none}
.chip.ok{--d:var(--go)}.chip.bad{--d:var(--no);cursor:default}
.chip.off{--d:var(--mut);border-style:dashed;color:var(--mut);text-decoration:line-through}

/* налаштування */
details{position:relative}
.panel{position:absolute;right:0;top:calc(100% + 8px);z-index:20;width:min(430px,92vw);max-height:calc(100dvh - 90px);overflow:auto;padding:16px;display:grid;gap:16px;background:var(--card);border:1px solid var(--line);border-radius:16px;box-shadow:0 18px 50px rgba(10,30,22,.28);scrollbar-width:thin}
.grp{display:grid;gap:8px}
.grp h3{font-size:13px;font-weight:600;color:var(--mut)}
.panel label{display:grid;gap:4px;font-size:13px;color:var(--mut)}
.panel label input{color:var(--fg)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.row2{display:flex;gap:8px}
#ss,#fs{font-size:13px;color:var(--mut)}
#ss.ok,#fs.ok{color:color-mix(in srgb,var(--go) 75%,var(--fg))}
#ss.bad,#fs.bad{color:var(--no)}
#pt th{font-size:11px;line-height:1.2;font-weight:500}
#pt td,#pt th{padding:3px 4px}
#pt td:first-child{white-space:nowrap;padding-left:8px}
#pt input{width:100%;min-width:0;min-height:34px;padding:3px 4px;text-align:center}

/* основна сітка */
main{flex:1;min-height:0;display:grid;gap:14px;grid-template-columns:1fr}
.card{display:flex;flex-direction:column;min-height:0;padding:16px;background:var(--card);border:1px solid var(--line);border-radius:18px;box-shadow:var(--sh)}

/* календар */
.nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;flex:none}
.nav h2{font:600 21px/1.2 var(--serif)}
.dws{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px;margin-bottom:6px;flex:none}
.dw{font-style:normal;text-align:center;font-size:12px;font-weight:500;color:var(--mut)}
.dw.we{color:color-mix(in srgb,var(--no) 65%,var(--mut))}
#cal{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));grid-auto-rows:68px;gap:6px}
.void{visibility:hidden}
.c{position:relative;min-width:0;min-height:0;padding:7px 9px;display:flex;flex-direction:column;justify-content:space-between;text-align:left;background:var(--soft);border:1.5px solid var(--line);border-radius:13px;transition:transform .12s,box-shadow .12s,border-color .12s}
.c:hover:not(:disabled){transform:translateY(-1px);border-color:var(--acc)}
.cn{display:flex;align-items:center;justify-content:space-between;gap:4px}
.cn b{min-width:1.8em;height:1.8em;display:inline-grid;place-items:center;border-radius:99px;font-size:clamp(14px,2.3vh,19px);font-weight:600;margin:-2px 0 0 -4px}
.c.td .cn b{background:var(--acc);color:var(--on)}
.cn em{font-style:normal;font-size:11px;font-weight:700;min-width:20px;height:20px;padding:0 6px;display:inline-grid;place-items:center;border-radius:99px;background:var(--acc);color:var(--on)}
.bt{display:flex;flex-direction:column;gap:1px;min-width:0}
.tp{display:flex;align-items:center;gap:4px;font-weight:600;font-size:clamp(13px,2vh,17px);line-height:1.2}
.tp .ic{color:var(--rain)}
.sun{display:flex;align-items:center;gap:3px;font-size:clamp(10px,1.45vh,12px);color:var(--mut);white-space:nowrap;overflow:hidden}
.sun .ic{color:var(--sun)}
.c.s2{border-color:color-mix(in srgb,var(--go) 70%,var(--line));background:color-mix(in srgb,var(--go) 13%,var(--card))}
.c.s1{border-color:color-mix(in srgb,var(--maybe) 75%,var(--line));background:color-mix(in srgb,var(--maybe) 13%,var(--card))}
.c.s0{border-color:color-mix(in srgb,var(--no) 45%,var(--line));background:color-mix(in srgb,var(--no) 7%,var(--card))}
.c.sn{opacity:.5}
.c.sel{box-shadow:0 0 0 2px var(--card),0 0 0 4px var(--acc)}
.legend{display:flex;flex-wrap:wrap;gap:6px 16px;margin:14px 0 0;padding:0;list-style:none;font-size:12.5px;color:var(--mut);flex:none}
.legend li{display:flex;align-items:center;gap:6px}
.lg{width:13px;height:13px;border-radius:4px;border:1.5px solid var(--line)}
.lg.s2{border-color:var(--go);background:color-mix(in srgb,var(--go) 18%,var(--card))}
.lg.s1{border-color:var(--maybe);background:color-mix(in srgb,var(--maybe) 18%,var(--card))}
.lg.s0{border-color:color-mix(in srgb,var(--no) 55%,var(--line));background:color-mix(in srgb,var(--no) 9%,var(--card))}
.hint{margin-top:6px;font-size:12.5px;color:var(--mut);flex:none}

/* картка дня */
.dtop{flex:none}
.dh{display:flex;align-items:center;flex-wrap:wrap;gap:6px 10px}
.dt{font:600 22px/1.2 var(--serif)}
.dt::first-letter{text-transform:uppercase}
.ds{display:none}
.tag{font-size:12px;font-weight:600;padding:2px 10px;border-radius:99px;background:var(--acc-soft);color:var(--acc)}
.sunbox{margin:14px 0 10px}
.sunbar{position:relative;height:10px;border-radius:99px;background:var(--soft);border:1px solid var(--line)}
.sunbar i{position:absolute;top:-1px;bottom:-1px;border-radius:99px;background:linear-gradient(90deg,#f4c04a,#e68a2e)}
.sunbar u{position:absolute;top:-5px;width:4px;height:18px;margin-left:-2px;border-radius:3px;background:var(--acc);box-shadow:0 0 0 2px var(--card)}
.sunt{display:flex;justify-content:space-between;flex-wrap:wrap;gap:2px 10px;margin-top:8px;font-size:13px;color:var(--mut)}
.sunt span{display:inline-flex;align-items:center;gap:5px}
.sunt b{color:var(--fg);font-weight:600}
.sunt .ic{color:var(--sun);font-size:15px}
.strip{display:grid;grid-template-columns:repeat(var(--n,12),minmax(0,1fr));gap:3px;margin:10px 0 8px}
.h{display:flex;flex-direction:column;align-items:center;min-width:0;padding:4px 0 5px;font-size:12px;line-height:1.25;border-radius:8px;background:var(--soft);border-bottom:3px solid var(--line)}
.h span{font-size:11px;color:var(--mut)}
.h b{font-weight:600}
.h.s2{border-bottom-color:var(--go);background:color-mix(in srgb,var(--go) 13%,var(--card))}
.h.s1{border-bottom-color:var(--maybe);background:color-mix(in srgb,var(--maybe) 13%,var(--card))}
.h.s0{border-bottom-color:color-mix(in srgb,var(--no) 55%,var(--line))}
.h.nt{border-bottom-color:var(--line);background:transparent;opacity:.5}
.h.now{box-shadow:0 0 0 2px var(--acc)}
.prof{font-size:13px;color:var(--mut)}
.prof b{color:var(--fg);font-weight:600}
.tw{overflow-x:auto;margin-top:10px;border:1px solid var(--line);border-radius:12px;scrollbar-width:thin}
table{width:100%;border-collapse:collapse;font-size:13px}
th{font-weight:500;color:var(--mut);text-align:left;padding:6px 10px;border-bottom:1px solid var(--line);white-space:nowrap}
td{padding:6px 10px;border-bottom:1px solid var(--line);white-space:nowrap}
tr:last-child td{border-bottom:0}
tr.off td{opacity:.45;text-decoration:line-through}
#pt{border:0}

/* справи */
.side{display:grid;gap:14px;min-height:0}
.th2{display:flex;align-items:baseline;gap:10px;flex:none}
.sh{display:flex;align-items:center;gap:8px;font-size:16px;font-weight:600}
.dsm{font-size:13px;color:var(--mut)}
.cnt{font-size:12px;font-weight:600;padding:1px 9px;border-radius:99px;background:var(--acc-soft);color:var(--acc)}
.tl{margin-top:10px}
.t,.ft{padding:9px 10px;margin-bottom:6px;background:var(--soft);border:1px solid var(--line);border-radius:12px}
.t{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:10px;align-items:start}
.t.dn{opacity:.6}.t.dn .tt{text-decoration:line-through}
.ck{width:26px;height:26px;min-height:0;margin-top:1px;padding:0;display:grid;place-items:center;border-radius:50%;border:2px solid var(--line);background:var(--card);color:transparent}
.ck:hover:not(:disabled){border-color:var(--acc);color:var(--acc)}
.t.dn .ck{background:var(--acc);border-color:var(--acc);color:var(--on)}
.ck svg,.x svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}
.x{width:30px;height:30px;min-height:0;padding:0;display:grid;place-items:center;border:0;background:transparent;color:var(--mut);border-radius:8px}
.x svg{width:16px;height:16px;stroke-width:2}
.x:hover:not(:disabled){color:var(--no);background:color-mix(in srgb,var(--no) 12%,transparent)}
.tb{min-width:0;flex:1}
.tt{display:block;font-weight:600;line-height:1.3;overflow-wrap:anywhere}
.tm{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin-top:6px;font-size:13px}
.tm select{min-height:32px;padding:3px 26px 3px 10px;font-size:13px;background-position:calc(100% - 14px) 54%,calc(100% - 9px) 54%}
.ti{display:flex;align-items:flex-start;gap:7px;margin-top:6px;font-size:13px}
.dot{width:8px;height:8px;margin-top:.5em;border-radius:50%;background:var(--mut);flex:none}
.ti.s2 .dot{background:var(--go)}.ti.s1 .dot{background:var(--maybe)}.ti.s0 .dot{background:var(--no)}
.ti.in,.ti.n{color:var(--mut)}
.alt{margin-top:4px;font-size:13px;color:var(--mut)}
.alt .gh{min-height:28px;padding:2px 10px;margin-left:4px}
.fh{display:flex;align-items:center;gap:8px;margin:14px 0 8px;font-size:15px;font-weight:600}
.ft{display:flex;justify-content:space-between;gap:10px;border-left:4px solid var(--maybe)}
.ft[data-p="1"]{border-left-color:var(--no)}.ft[data-p="3"]{border-left-color:var(--go)}
.pill{flex:none;align-self:flex-start;font-size:12px;padding:2px 10px;border-radius:99px;background:var(--card);border:1px solid var(--line);color:var(--mut);white-space:nowrap}
#add{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) 68px auto;gap:8px;margin-top:10px;flex:none}
#add input[name=title]{grid-column:1/4}
#add .pri{grid-column:4;grid-row:1/3;align-self:stretch;padding:0 18px}
.srcs{margin-top:10px}
.srcs>summary{display:flex;align-items:center;gap:8px;min-height:32px;cursor:pointer;font-size:13px;color:var(--mut)}
.srcs>summary::before{content:"";width:7px;height:7px;border-right:2px solid currentColor;border-bottom:2px solid currentColor;transform:rotate(-45deg);transition:transform .15s}
.srcs[open]>summary::before{transform:rotate(45deg)}
.srcs .tw{margin-top:4px}

.dnav{display:flex;align-items:center;gap:8px}
.dtw{flex:1;min-width:0;display:flex;align-items:center;flex-wrap:wrap;gap:4px 10px}
.wsum{display:none;width:100%;min-height:44px;margin-top:10px;padding:8px 12px;align-items:center;justify-content:space-between;gap:10px;text-align:left;background:var(--soft);border:1px solid var(--line);border-radius:12px;font-size:14px}
.wsum .ti{margin:0;font-size:14px;font-weight:500}
.chv{width:18px;height:18px;flex:none;fill:none;stroke:var(--mut);stroke-width:2;stroke-linecap:round;stroke-linejoin:round;transition:transform .15s}
.wx.open .chv{transform:rotate(180deg)}
@media (max-width:999px),(max-height:640px){
  .wsum{display:flex}
  .wx:not(.open) .wxb{display:none}
}
@media (max-width:1199px){.sun{display:none}}
@media (max-width:999px){
  .top{grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"brand right" "bar bar"}
  h1{font-size:18px}
  .bar{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;margin:0 -2px;padding:0 2px 2px}
  .bar>*{flex:none}
  #src{flex-wrap:nowrap}
  details{position:static}
  .panel{position:fixed;left:10px;right:10px;top:calc(env(safe-area-inset-top) + 66px);width:auto;max-height:calc(100dvh - env(safe-area-inset-top) - 82px)}
}
/* від 700px: дві рівні колонки, висота екрана фіксована, прокручуються лише списки */
@media (min-width:700px){
  body{height:100dvh;overflow:hidden}
  main{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
  #cal{flex:1;min-height:0;grid-auto-rows:1fr}
  .side{grid-template-rows:auto minmax(0,1fr)}
  .tk{overflow:hidden}
  .tl{flex:1;min-height:0;overflow-y:auto;scrollbar-width:thin;margin-right:-6px;padding-right:6px}
  .panel{left:auto;width:min(430px,calc(100vw - 20px))}
}
@media (min-width:1000px){
  main{grid-template-columns:minmax(0,1.5fr) minmax(390px,1fr)}
}
/* до 700px (телефон у портреті): календар зверху, день одразу під ним, без порожнього місця */
@media (max-width:699px){
  main{grid-template-rows:auto 1fr}
  #cal{grid-auto-rows:56px}
  .side{grid-template-rows:auto 1fr}
  .tl{flex:1}
}
@media (max-width:600px){
  body{gap:10px;font-size:15px}
  .card{padding:12px;border-radius:16px}
  .nav h2{font-size:19px}
  #cal,.dws{gap:4px}
  .c{padding:5px 6px;border-radius:11px}
  .cn b{font-size:14px}
  .tp{font-size:13px}
  .sun,.hint{display:none}
  input,select{font-size:16px}
  .tm select{font-size:15px}
  .strip{grid-template-columns:repeat(7,minmax(0,1fr))}
  .dt{font-size:20px}
  #add{grid-template-columns:minmax(0,1fr) minmax(0,1fr) 64px}
  #add input[name=title]{grid-column:1/-1}
  #add .pri{grid-column:1/-1;grid-row:auto;min-height:42px;padding:6px 12px}
  .ft{flex-direction:column}
  .pill{align-self:flex-start}
  .two{grid-template-columns:1fr 1fr}
  .bar{flex-wrap:wrap;overflow:visible;margin:0;padding:0;gap:6px}
  #pf{order:1;flex:1 1 120px}
  #rf{order:2}
  #db{order:3}
  #src{order:4;flex:1 1 100%;flex-wrap:wrap;gap:5px}
  #upd{order:5;font-size:12px}
  .chip{padding:2px 9px;font-size:11.5px;min-height:26px}
  .cn em{position:absolute;top:6px;right:6px;width:8px;height:8px;min-width:0;padding:0;font-size:0;border-radius:50%}
  .dl{display:none}.ds{display:inline}
}
@media (max-width:380px){
  .strip{grid-template-columns:repeat(6,minmax(0,1fr))}
  .c{padding:4px 5px}
}
@media (max-height:640px) and (min-width:700px){
  .side{overflow-y:auto;grid-template-rows:auto auto;align-content:start;scrollbar-width:thin}
  .tk{overflow:visible}
  .tl{flex:none;overflow:visible;margin-right:0;padding-right:0}
}
@media (max-height:500px) and (min-width:700px){
  body{gap:8px;padding-top:max(8px,env(safe-area-inset-top));padding-bottom:max(8px,env(safe-area-inset-bottom))}
  .top{grid-template-columns:auto minmax(0,1fr) auto;grid-template-areas:"brand bar right";gap:8px 12px}
  h1{font-size:16px}
  .logo{width:30px;height:30px;border-radius:10px}
  .logo svg{width:18px;height:18px}
  .bar{margin:0;padding:0}
  .panel{top:calc(env(safe-area-inset-top) + 52px);max-height:calc(100dvh - env(safe-area-inset-top) - 64px)}
  .card{padding:10px 12px}
  .nav{margin-bottom:6px}
  .nav h2{font-size:17px}
  .ib{width:34px;height:34px}
  .dt{font-size:17px}
  .legend,.hint{display:none}
  .dws{margin-bottom:4px}
  .c{flex-direction:row;align-items:center;padding:2px 8px}
  .cn b{margin:0;min-width:1.6em;height:1.6em;font-size:14px}
  .bt{flex-direction:row}
  .tp{font-size:13px}
  .tp .ic{display:none}
  .tp.rn{color:var(--rain)}
  .cn em{position:absolute;top:4px;right:4px;width:7px;height:7px;min-width:0;padding:0;font-size:0;border-radius:50%}
  #upd{display:none}
  .chip{padding:2px 8px;font-size:11px;min-height:26px}
  .bar select{min-height:32px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<header class="top">
  <div class="brand">
    <span class="logo" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span>
    <h1>Погодний планувальник</h1>
  </div>
  <div class="bar">
    <select id="pf" aria-label="Профіль активності"></select>
    <span id="src"></span>
    <span id="db" class="chip"></span>
    <button id="rf" class="gh" title="Оновити прогноз">Оновити</button>
    <span id="upd" class="mut"></span>
  </div>
  <div class="right">
    <button id="th" class="ib"></button>
    <details>
      <summary class="ib" title="Налаштування" aria-label="Налаштування"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></summary>
      <div class="panel">
        <section class="grp">
          <h3>Пороги активностей</h3>
          <div class="tw"><table id="pt"></table></div>
          <button id="rs" class="gh" type="button">Скинути пороги</button>
        </section>
        <section class="grp">
          <h3>Місце і база планувальника</h3>
          <div class="two">
            <label>Широта<input id="lat" inputmode="decimal"></label>
            <label>Довгота<input id="lon" inputmode="decimal"></label>
          </div>
          <label>Supabase URL<input id="url" inputmode="url" autocomplete="off" placeholder="https://xxx.supabase.co"></label>
          <label>Supabase anon key<input id="key" autocomplete="off"></label>
        </section>
        <section class="grp">
          <h3>Родинна дошка (лише перегляд моїх задач)</h3>
          <label>URL проєкту дошки<input id="furl" inputmode="url" autocomplete="off" placeholder="https://xxx.supabase.co"></label>
          <label>Ключ дошки (publishable або anon)<input id="fkey" autocomplete="off"></label>
          <label>Моє ім'я в дошці<input id="fperson" autocomplete="off"></label>
        </section>
        <div class="grp">
          <button id="sv" class="pri" type="button">Зберегти</button>
          <div id="ss" role="status"></div>
        </div>
        <section class="grp">
          <h3>Вхід у родинну дошку</h3>
          <label>Email<input id="femail" type="email" autocomplete="username"></label>
          <label>Пароль<input id="fpass" type="password" autocomplete="current-password"></label>
          <div class="row2"><button id="fl" class="pri" type="button">Увійти</button><button id="fo" class="gh" type="button">Вийти</button></div>
          <div id="fs" role="status"></div>
        </section>
      </div>
    </details>
  </div>
</header>
<p id="note" role="status"></p>
<main>
  <section class="card" aria-label="Календар">
    <div class="nav">
      <button id="pm" class="ib" aria-label="Попередній місяць"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
      <h2 id="mt"></h2>
      <button id="nm" class="ib" aria-label="Наступний місяць"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
    </div>
    <div class="dws" id="dws" aria-hidden="true"></div>
    <div id="cal"></div>
    <ul class="legend">
      <li><i class="lg s2"></i>Є вікно на 2 години</li>
      <li><i class="lg s1"></i>Джерела розходяться</li>
      <li><i class="lg s0"></i>Вікон немає</li>
      <li><i class="lg"></i>Прогнозу ще немає</li>
    </ul>
    <p class="hint">Назви джерел угорі клікабельні: натисни, щоб вимкнути джерело з розрахунків.</p>
  </section>
  <div class="side" id="day"></div>
</main>

<script is:inline>
const $=s=>document.querySelector(s);
const PROFILES={
  run:{n:'Біг',tmin:3,tmax:24,w:25,p:0.1},
  bike:{n:'Велосипед',tmin:8,tmax:30,w:20,p:0.1},
  walk:{n:'Прогулянка',tmin:-5,tmax:30,w:35,p:0.3},
  work:{n:'Вуличні роботи',tmin:2,tmax:32,w:40,p:0.2}
};
const DEF=JSON.parse(JSON.stringify(PROFILES));
(()=>{try{const o=JSON.parse(localStorage.wp_prof||'{}');for(const k in o)if(PROFILES[k])Object.assign(PROFILES[k],o[k])}catch(e){}})();
const saveProf=()=>localStorage.wp_prof=JSON.stringify(Object.fromEntries(Object.entries(PROFILES).map(([k,v])=>[k,{tmin:v.tmin,tmax:v.tmax,w:v.w,p:v.p}])));
const SOURCES=['OM-ECMWF','OM-GFS','OM-ICON','MET.no'];
const DOW=['Пн','Вт','Ср','Чт','Пт','Сб','Нд'];
const MON=['Січень','Лютий','Березень','Квітень','Травень','Червень','Липень','Серпень','Вересень','Жовтень','Листопад','Грудень'];
let cfg=Object.assign({lat:48.53,lon:25.04,url:'',key:'',furl:'',fkey:'',fperson:'Олександр'},JSON.parse(localStorage.wp_cfg||'{}'));
let H={},SUN={},TZ='Europe/Kyiv',tasks=[],sb=null,pf='run',cur=new Date(),FMT=null;
let today=new Date().toLocaleDateString('en-CA'),sel=today;
let off=new Set(JSON.parse(localStorage.wp_off||'[]'));

const pad=n=>String(n).padStart(2,'0');
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const med=a=>{a=a.slice().sort((x,y)=>x-y);const n=a.length;return n?(n%2?a[(n-1)/2]:(a[n/2-1]+a[n/2])/2):null};
const hm=s=>{const [h,m]=s.slice(11,16).split(':');return +h+m/60};
const fh=x=>{const m=Math.round(x*60);return pad(Math.floor(m/60)%24)+':'+pad(m%60)};
const rng=r=>r.map(([a,b])=>fh(a)+'–'+fh(b)).join(', ');
const fmtDate=d=>new Date(d+'T12:00').toLocaleDateString('uk-UA',{weekday:'long',day:'numeric',month:'long'});
const note=m=>{$('#note').textContent=m||''};
/* значення лише з увімкнених джерел */
const act=o=>Object.entries(o).filter(([k])=>!off.has(k)).map(([,v])=>v);
function avail(){
  const s=new Set();
  Object.values(H).forEach(d=>Object.values(d).forEach(o=>Object.keys(o).forEach(k=>s.add(k))));
  return s;
}

function setTheme(t){
  document.documentElement.dataset.theme=t;localStorage.wp_theme=t;
  const sun='<circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>';
  const moon='<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>';
  const label=t==='dark'?'Світла тема':'Темна тема';
  $('#th').innerHTML=`<svg viewBox="0 0 24 24" aria-hidden="true">${t==='dark'?sun:moon}</svg>`;
  $('#th').title=label;$('#th').setAttribute('aria-label',label);
}

function local(dt){
  FMT=FMT||new Intl.DateTimeFormat('en-CA',{timeZone:TZ,year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',hourCycle:'h23'});
  const p=Object.fromEntries(FMT.formatToParts(dt).map(x=>[x.type,x.value]));
  return [`${p.year}-${p.month}-${p.day}`,+p.hour];
}
function put(d,h,src,t,p,w){((H[d]??={})[h]??={})[src]={t,p:p||0,w:w||0}}

async function loadWeather(){
  H={};SUN={};FMT=null;note('');
  const {lat,lon}=cfg;
  try{
    const j=await (await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&daily=sunrise,sunset&timezone=auto&past_days=1&forecast_days=10`)).json();
    TZ=j.timezone;today=local(new Date())[0];
    j.daily.time.forEach((d,i)=>SUN[d]={sr:hm(j.daily.sunrise[i]),ss:hm(j.daily.sunset[i])});
  }catch(e){note('Не вдалося отримати схід і захід сонця.')}
  const models=['ecmwf_ifs025','gfs_seamless','icon_seamless'];
  try{
    const j=await (await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&hourly=temperature_2m,precipitation,wind_speed_10m&models=${models.join(',')}&timezone=auto&forecast_days=10`)).json();
    j.hourly.time.forEach((t,i)=>models.forEach(m=>{
      const T=j.hourly['temperature_2m_'+m]?.[i];if(T==null)return;
      put(t.slice(0,10),+t.slice(11,13),'OM-'+m.split('_')[0].toUpperCase(),T,j.hourly['precipitation_'+m][i],j.hourly['wind_speed_10m_'+m][i]);
    }));
  }catch(e){}
  try{
    const j=await (await fetch(`https://api.met.no/weatherdata/locationforecast/2.0/compact?lat=${lat}&lon=${lon}`)).json();
    for(const e of j.properties.timeseries){
      const d=e.data,i=d.instant.details,one=d.next_1_hours,six=d.next_6_hours;
      const span=one?1:(six?6:1),pr=one?one.details.precipitation_amount:(six?six.details.precipitation_amount/6:0);
      for(let k=0;k<span;k++){
        const [dd,hh]=local(new Date(new Date(e.time).getTime()+k*3600e3));
        put(dd,hh,'MET.no',i.air_temperature,pr,i.wind_speed*3.6);
      }
    }
  }catch(e){}
}

/* 2 — усі джерела згодні, 1 — розходяться, 0 — не підходить, null — немає даних */
function hourSt(d,h,pf){
  const P=PROFILES[pf],s=SUN[d],o=H[d]?.[h];if(!o)return null;
  const v=act(o),n=v.length;if(!n)return null;
  if(s&&(h+1<=s.sr||h>=s.ss))return 0;
  const ok=v.filter(x=>x.t>=P.tmin&&x.t<=P.tmax&&x.w<=P.w&&x.p<=P.p).length;
  return ok===n?2:(ok>0&&ok>=n/2)?1:0;
}
function win(d,pf,dur){
  const w=[];
  for(let h=0;h+dur<=24;h++){
    let m=2;
    for(let k=0;k<dur;k++){const s=hourSt(d,h+k,pf);if(s==null){m=null;break}m=Math.min(m,s)}
    if(m!=null)w.push([h,m]);
  }
  if(!w.length)return{st:null,r:[]};
  const top=Math.max(...w.map(x=>x[1]));
  if(!top)return{st:0,r:[]};
  const r=[];
  w.filter(x=>x[1]===top).forEach(([h])=>{
    const L=r[r.length-1];
    if(L&&L[2]===h-1){L[1]=h+dur;L[2]=h}else r.push([h,h+dur,h]);
  });
  return{st:top,r:r.map(x=>[x[0],x[1]])};
}
function dayInfo(d){
  if(!H[d])return null;
  let tmax=-99,rain=0;
  for(let h=6;h<22;h++){
    const o=H[d][h];if(!o)continue;const v=act(o);if(!v.length)continue;
    tmax=Math.max(tmax,med(v.map(x=>x.t)));rain+=med(v.map(x=>x.p));
  }
  return tmax===-99?null:{tmax,rain};
}
function srcStats(d){
  const r={};
  for(const h in H[d])for(const [k,v] of Object.entries(H[d][h])){
    const s=r[k]??={tmin:99,tmax:-99,p:0,w:0};
    s.tmin=Math.min(s.tmin,v.t);s.tmax=Math.max(s.tmax,v.t);s.p+=v.p;s.w=Math.max(s.w,v.w);
  }
  return r;
}

function nextOk(t){
  for(const d of Object.keys(H).sort()){
    if(d<=t.date||d<today)continue;
    const w=win(d,t.profile,t.duration);
    if(w.st>0)return{d,w};
  }
  return null;
}
function taskInfo(t){
  if(t.kind==='in')return{c:'in',txt:'хатня справа, від погоди не залежить'};
  const w=win(t.date,t.profile,t.duration);
  if(w.st==null)return{c:'n',txt:'на цю дату прогнозу ще немає'};
  if(w.st>0)return{c:'s'+w.st,txt:(w.st==2?'підходить: ':'джерела розходяться, можливі вікна: ')+rng(w.r)};
  return{c:'s0',txt:'вікон немає',alt:nextOk(t)};
}

const IC={
  sun:'<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>',
  rain:'<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3s6 6.2 6 10.5a6 6 0 0 1-12 0C6 9.2 12 3 12 3z"/></svg>'
};
const STW={2:'є вікно',1:'джерела розходяться',0:'вікон немає'};

function renderCal(){
  const y=cur.getFullYear(),m=cur.getMonth();
  $('#mt').textContent=MON[m]+' '+y;
  $('#dws').innerHTML=DOW.map((d,i)=>`<i class="dw${i>4?' we':''}">${d}</i>`).join('');
  let h='';
  const first=(new Date(y,m,1).getDay()+6)%7,nd=new Date(y,m+1,0).getDate();
  for(let i=0;i<first;i++)h+='<i class="void"></i>';
  for(let d=1;d<=nd;d++){
    const ds=`${y}-${pad(m+1)}-${pad(d)}`,w=win(ds,pf,2),inf=dayInfo(ds),sn=SUN[ds];
    const nt=tasks.filter(t=>t.date===ds&&!t.done).length;
    const lbl=`${fmtDate(ds)}. ${STW[w.st]||'прогнозу ще немає'}.`+(inf?` До ${Math.round(inf.tmax)}°${inf.rain>=0.5?', дощ':''}.`:'')+(nt?` Справ: ${nt}.`:'');
    h+=`<button type="button" class="c s${w.st==null?'n':w.st}${ds===sel?' sel':''}${ds===today?' td':''}" data-d="${ds}" aria-label="${lbl}" aria-pressed="${ds===sel}"${ds===today?' aria-current="date"':''}>`+
       `<span class="cn"><b>${d}</b>${nt?`<em title="Справ: ${nt}">${nt}</em>`:''}</span>`+
       `<span class="bt"><span class="tp${inf&&inf.rain>=0.5?' rn':''}">${inf?Math.round(inf.tmax)+'°'+(inf.rain>=0.5?IC.rain:''):'&nbsp;'}</span>`+
       (sn?`<span class="sun">${IC.sun}${fh(sn.sr)}–${fh(sn.ss)}</span>`:'')+`</span></button>`;
  }
  $('#cal').innerHTML=h;
}

let srcOpen=false,wxOpen=false;
function renderDay(){
  const keep=$('#add')?.elements.title.value||'';
  const keepTop=$('#day .tl')?.scrollTop||0;
  const d=sel,s=SUN[d],P=PROFILES[pf];
  const inf0=dayInfo(d),w2=win(d,pf,2);
  const sw=w2.st==null?'прогнозу ще немає':w2.st>0?`${P.n}: ${rng(w2.r)}`:`${P.n}: вікон немає`;
  const dlong=fmtDate(d),dshort=new Date(d+'T12:00').toLocaleDateString('uk-UA',{weekday:'short',day:'numeric',month:'long'});
  let h=`<section class="card wx${wxOpen?' open':''}"><div class="dnav"><div class="dtw"><h2 class="dt"><span class="dl">${dlong}</span><span class="ds">${dshort}</span></h2>${d===today?'<span class="tag">Сьогодні</span>':''}</div></div>`+
    `<button type="button" class="wsum" data-wx="1" aria-expanded="${wxOpen}"><span class="ti ${w2.st==null?'n':'s'+w2.st}"><i class="dot"></i><span>${inf0?Math.round(inf0.tmax)+'° · ':''}${sw}</span></span><svg class="chv" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button>`+
    `<div class="wxb">`;
  if(s){
    const L=s.ss-s.sr,tm=Math.round(L*60),pv=SUN[new Date(new Date(d+'T12:00').getTime()-864e5).toLocaleDateString('en-CA')];
    const dl=pv?Math.round((L-(pv.ss-pv.sr))*60):null;
    const now=d===today?(local(new Date())[1]+new Date().getMinutes()/60)/24*100:null;
    h+=`<div class="sunbox"><div class="sunbar" role="img" aria-label="Світловий день ${fh(s.sr)}–${fh(s.ss)}"><i style="left:${s.sr/24*100}%;width:${L/24*100}%"></i>${now!=null?`<u style="left:${now}%"></u>`:''}</div>`+
       `<div class="sunt"><span>${IC.sun}Схід <b>${fh(s.sr)}</b></span><span>${Math.floor(tm/60)} год ${tm%60} хв${dl==null||dl===0?'':` · ${dl>0?'+':'−'}${Math.abs(dl)} хв до вчора`}</span><span>Захід <b>${fh(s.ss)}</b></span></div></div>`;
  }
  if(H[d]){
    const nowH=d===today?local(new Date())[1]:-1;
    /* показуємо лише світлу частину доби з запасом в годину */
    let a0=0,a1=23;
    if(s){a0=Math.max(0,Math.floor(s.sr)-1);a1=Math.min(23,Math.ceil(s.ss))}
    const hrs=[];for(let x=a0;x<=a1;x++)hrs.push(x);
    const cols=hrs.length>14?Math.ceil(hrs.length/2):hrs.length;
    h+=`<div class="strip" role="list" style="--n:${cols}">`+hrs.map(x=>{
      const st=hourSt(d,x,pf),o=H[d][x],a=o?act(o):[];
      const t=a.length?Math.round(med(a.map(v=>v.t)))+'°':'–';
      const nt=s&&(x+1<=s.sr||x>=s.ss);
      return `<div class="h s${st==null?'n':st}${nt?' nt':''}${x===nowH?' now':''}" role="listitem" title="${x}:00, ${t}"><span>${x}</span><b>${t}</b></div>`;
    }).join('')+`</div>`;
    h+=`<p class="prof"><b>${P.n}</b>: ${P.tmin}…${P.tmax}°, вітер до ${P.w} км/год, опади до ${P.p} мм/год</p>`;
    h+=`<details class="srcs"${srcOpen?' open':''}><summary>Прогноз за джерелами</summary><div class="tw"><table><tr><th>Джерело</th><th>Температура</th><th>Опади</th><th>Макс. вітер</th></tr>`+
      Object.entries(srcStats(d)).map(([k,v])=>`<tr${off.has(k)?' class="off"':''}><td>${k}</td><td>${Math.round(v.tmin)}…${Math.round(v.tmax)}°</td><td>${v.p.toFixed(1)} мм</td><td>${Math.round(v.w)} км/год</td></tr>`).join('')+`</table></div></details>`;
  }else h+=`<p class="mut" style="margin-top:12px">Прогноз на цю дату ще недоступний.</p>`;
  h+=`</div></section>`;

  const list=tasks.filter(t=>t.date===d);
  const short=new Date(d+'T12:00').toLocaleDateString('uk-UA',{day:'numeric',month:'long'});
  h+=`<section class="card tk"><div class="th2"><h3 class="sh">Справи${list.length?`<span class="cnt">${list.length}</span>`:''}</h3><span class="dsm">${short}</span></div><div class="tl">`;
  if(!list.length)h+=`<p class="mut" style="margin-bottom:8px">Справ поки немає. Додай першу нижче.</p>`;
  for(const t of list){
    const i=taskInfo(t);
    h+=`<div class="t${t.done?' dn':''}">`+
       `<button type="button" class="ck" data-dn="${t.id}" aria-label="${t.done?'Повернути в роботу':'Позначити виконаною'}" title="${t.done?'Повернути в роботу':'Позначити виконаною'}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></button>`+
       `<div class="tb"><b class="tt">${esc(t.title)}</b>`+
       `<div class="tm"><select data-ek="${t.id}" aria-label="Вид">${kindOpts(t.kind)}</select>${t.kind==='out'?`<select data-ep="${t.id}" aria-label="Категорія">${profOpts(t.profile)}</select>`:''}</div>`+
       `<div class="ti ${i.c}"><i class="dot"></i><span>${t.duration} год · ${i.txt}</span></div>`+
       (i.alt?`<div class="alt">Найближче вікно: ${fmtDate(i.alt.d)}, ${rng(i.alt.w.r)} <button type="button" class="gh" data-mv="${t.id}" data-to="${i.alt.d}">Перенести</button></div>`:(i.c==='s0'?'<div class="alt">У прогнозі вікон ще немає</div>':''))+
       `</div><button type="button" class="x" data-rm="${t.id}" aria-label="Видалити справу" title="Видалити"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button></div>`;
  }
  h+=famHtml();
  h+=`</div><form id="add"><input name="title" placeholder="Що зробити" aria-label="Назва справи" autocomplete="off" enterkeyhint="done" required>`+
     `<select name="kind" aria-label="Вид"><option value="out">Вулична</option><option value="in">Хатня</option></select>`+
     `<select name="profile" aria-label="Категорія">${Object.entries(PROFILES).map(([k,v])=>`<option value="${k}"${k===pf?' selected':''}>${v.n}</option>`).join('')}</select>`+
     `<input name="duration" type="number" min="1" max="12" value="1" inputmode="numeric" aria-label="Тривалість, год">`+
     `<button class="pri">Додати</button></form></section>`;
  $('#day').innerHTML=h;
  if(keep)$('#add').elements.title.value=keep;
  if(keepTop)$('#day .tl').scrollTop=keepTop;
}
const SHORT={'OM-ECMWF':'ECMWF','OM-GFS':'GFS','OM-ICON':'ICON','MET.no':'MET.no'};
function renderSrc(){
  const have=avail();
  $('#src').innerHTML=SOURCES.map(k=>`<button class="chip ${!have.has(k)?'bad':off.has(k)?'off':'ok'}" data-s="${k}" title="${k}: ${!have.has(k)?'джерело недоступне':off.has(k)?'вимкнено, натисни щоб увімкнути':'увімкнено, натисни щоб вимкнути'}">${SHORT[k]||k}</button>`).join('');
}
function render(){renderSrc();renderDb();renderCal();renderDay()}

/* зберігання: Supabase або localStorage як запасний варіант */
const kindOpts=k=>`<option value="out"${k==='out'?' selected':''}>Вулична</option><option value="in"${k==='in'?' selected':''}>Хатня</option>`;
const profOpts=p=>Object.entries(PROFILES).map(([k,v])=>`<option value="${k}"${k===p?' selected':''}>${v.n}</option>`).join('');

/* вид і категорія родинних задач: зберігаються тут, у родинній дошці нічого не міняється */
let famMeta={};
async function metaLoad(){
  famMeta=JSON.parse(localStorage.wp_fmeta||'{}');
  if(!sb)return;
  const r=await sb.from('wp_family_meta').select('*');
  if(r.error){note('Категорії родинних задач: '+r.error.message+' (беру локальні)');return}
  famMeta=Object.fromEntries(r.data.map(x=>[x.task_id,{kind:x.kind,profile:x.profile}]));
}
async function metaSet(id,p){
  famMeta[id]=Object.assign(famMeta[id]||{},p);
  if(sb){
    const r=await sb.from('wp_family_meta').upsert({task_id:Number(id),kind:famMeta[id].kind||null,profile:famMeta[id].profile||null});
    if(r.error){note(r.error.message);localStorage.wp_fmeta=JSON.stringify(famMeta)}
  }else localStorage.wp_fmeta=JSON.stringify(famMeta);
}

/* родинна дошка: окремий клієнт Supabase, лише читання */
let fsb=null,fsbId='',famTasks=[],famState={mode:'off',msg:''};
const FS={todo:'До виконання',doing:'В роботі'};
async function famLoad(){
  famTasks=[];
  if(!(cfg.furl&&cfg.fkey)){fsb=null;fsbId='';famState={mode:'off',msg:''};return}
  if(!window.supabase){famState={mode:'err',msg:'бібліотека Supabase не завантажилась'};return}
  const id=cfg.furl+'|'+cfg.fkey;
  if(id!==fsbId){fsb=supabase.createClient(cfg.furl,cfg.fkey,{auth:{storageKey:'wp-family-auth'}});fsbId=id}
  try{
    const {data:{session}}=await fsb.auth.getSession();
    if(!session){famState={mode:'login',msg:''};return}
    const r=await fsb.from('family_tasks').select('*').eq('person',cfg.fperson).neq('status','done').order('priority').order('id');
    if(r.error){famState={mode:'err',msg:r.error.message};return}
    famTasks=r.data;famState={mode:'ok',msg:''};
  }catch(e){famState={mode:'err',msg:String(e.message||e)}}
}
function famInfo(){
  const m=famState.mode;
  if(m==='login')return ' Родинна дошка: виконай вхід нижче.';
  if(m==='ok')return ` Родинна дошка: задач для «${cfg.fperson}»: ${famTasks.length}.`;
  if(m==='err')return ` Родинна дошка: помилка (${famState.msg}).`;
  return '';
}
function famHtml(){
  const m=famState.mode;if(m==='off')return '';
  const h=`<h3 class="fh">З родинної дошки (лише перегляд)</h3>`;
  if(m==='login')return h+'<p class="mut">Щоб бачити задачі, увійди в налаштуваннях (шестірня, розділ «Вхід у родинну дошку»).</p>';
  if(m==='err')return h+`<p class="err">Не вдалося завантажити: ${esc(famState.msg)}</p>`;
  if(!famTasks.length)return h+`<p class="mut">Відкритих задач для «${esc(cfg.fperson)}» немає.</p>`;
  return h+famTasks.map(t=>{
    const m=famMeta[t.id]||{},p=m.profile||pf;
    const i=m.kind?taskInfo({kind:m.kind,profile:p,date:sel,duration:1}):null;
    return `<div class="ft" data-p="${t.priority}"><div class="tb"><b class="tt">${esc(t.text)}</b>`+
      `<div class="tm"><select data-fk="${t.id}" aria-label="Вид"><option value=""${m.kind?'':' selected'}>Вид…</option>${kindOpts(m.kind)}</select>`+
      (m.kind==='out'?`<select data-fp="${t.id}" aria-label="Категорія">${profOpts(p)}</select>`:'')+`</div>`+
      (i?`<div class="ti ${i.c}"><i class="dot"></i><span>${i.txt}</span></div>`:'')+`</div>`+
      `<span class="pill">${FS[t.status]||esc(t.status)}</span></div>`;
  }).join('');
}

let dbState={mode:'local',msg:''};
async function dbLoad(){
  dbState={mode:'local',msg:''};
  if(cfg.url&&cfg.key&&!window.supabase)dbState={mode:'err',msg:'бібліотека Supabase не завантажилась'};
  if(sb){
    try{
      const r=await sb.from('wp_tasks').select('*').order('date');
      if(!r.error){tasks=r.data;dbState={mode:'sb',msg:''};return}
      dbState={mode:'err',msg:r.error.message};
    }catch(e){dbState={mode:'err',msg:String(e.message||e)}}
    note('Supabase: '+dbState.msg+'. Працюю локально.');sb=null;
  }
  tasks=JSON.parse(localStorage.wp_tasks||'[]');
}
function renderDb(){
  const e=$('#db'),m=dbState.mode;
  e.className='chip '+(m==='sb'?'ok':m==='err'?'bad':'');
  e.textContent=m==='sb'?'Supabase':m==='err'?'Помилка бази':'Локально';
  e.title=m==='err'?dbState.msg:m==='sb'?'Справи зберігаються в Supabase':'Справи зберігаються лише в цьому браузері';
}
const lsSave=()=>{if(!sb)localStorage.wp_tasks=JSON.stringify(tasks)};
async function dbAdd(t){
  if(sb){const r=await sb.from('wp_tasks').insert(t).select().single();if(r.error)return note(r.error.message);tasks.push(r.data)}
  else{t.id=Date.now();tasks.push(t);lsSave()}
}
async function dbSet(id,p){
  const t=tasks.find(x=>x.id==id);Object.assign(t,p);
  if(sb){const r=await sb.from('wp_tasks').update(p).eq('id',id);if(r.error)note(r.error.message)}else lsSave();
}
async function dbDel(id){
  tasks=tasks.filter(x=>x.id!=id);
  if(sb){const r=await sb.from('wp_tasks').delete().eq('id',id);if(r.error)note(r.error.message)}else lsSave();
}

$('#pf').innerHTML=Object.entries(PROFILES).map(([k,v])=>`<option value="${k}">${v.n}</option>`).join('');
$('#pf').onchange=e=>{pf=e.target.value;render()};
$('#th').onclick=()=>setTheme(document.documentElement.dataset.theme==='dark'?'light':'dark');
$('#src').onclick=e=>{
  const b=e.target.closest('[data-s]');if(!b)return;
  const k=b.dataset.s,have=avail();if(!have.has(k))return;
  if(off.has(k))off.delete(k);
  else{
    if(![...have].some(x=>x!==k&&!off.has(x))){note('Має лишитись хоча б одне джерело.');return}
    off.add(k);
  }
  note('');localStorage.wp_off=JSON.stringify([...off]);render();
};
$('#pm').onclick=()=>{cur=new Date(cur.getFullYear(),cur.getMonth()-1,1);renderCal()};
$('#nm').onclick=()=>{cur=new Date(cur.getFullYear(),cur.getMonth()+1,1);renderCal()};
$('#cal').onclick=e=>{
  const b=e.target.closest('[data-d]');if(!b)return;
  sel=b.dataset.d;render();
  if(matchMedia('(max-width:699px)').matches)$('#day .wx')?.scrollIntoView({block:'nearest',behavior:'smooth'});
};
$('#rf').onclick=async()=>{
  const b=$('#rf');b.disabled=true;b.textContent='Оновлюю…';
  await init();
  b.disabled=false;b.textContent='Оновити';
};
$('#day').onclick=async e=>{
  const b=e.target.closest('button');if(!b)return;
  if(b.dataset.wx){wxOpen=!wxOpen;b.closest('.wx').classList.toggle('open',wxOpen);b.setAttribute('aria-expanded',String(wxOpen));return}
  if(b.dataset.dn){const t=tasks.find(x=>x.id==b.dataset.dn);await dbSet(t.id,{done:!t.done})}
  else if(b.dataset.rm)await dbDel(b.dataset.rm);
  else if(b.dataset.mv){await dbSet(b.dataset.mv,{date:b.dataset.to});sel=b.dataset.to}
  else return;
  render();
};
$('#day').addEventListener('toggle',e=>{if(e.target.classList&&e.target.classList.contains('srcs'))srcOpen=e.target.open},true);
$('#day').onchange=async e=>{
  const s=e.target;
  if(s.dataset.fk||s.dataset.fp){
    const fid=s.dataset.fk||s.dataset.fp,m=famMeta[fid]||{};
    if(s.dataset.fk){const kind=s.value;await metaSet(fid,{kind:kind||null,profile:kind==='out'?(m.profile||pf):null})}
    else await metaSet(fid,{profile:s.value});
    renderDay();return;
  }
  const id=s.dataset.ek||s.dataset.ep;if(!id)return;
  if(s.dataset.ek){
    const kind=s.value,t=tasks.find(x=>x.id==id);
    await dbSet(id,{kind,profile:kind==='out'?(t.profile||pf):null});
  }else await dbSet(id,{profile:s.value});
  render();
};
$('#day').onsubmit=async e=>{
  e.preventDefault();const f=new FormData(e.target),kind=f.get('kind');
  await dbAdd({title:f.get('title').trim(),kind,profile:kind==='out'?f.get('profile'):null,date:sel,duration:Math.max(1,+f.get('duration')||1),done:false});
  render();
};
function renderProf(){
  const F=[['tmin','Температура від, °',1],['tmax','Температура до, °',1],['w','Вітер до, км/год',1],['p','Опади до, мм/год',0.1]];
  $('#pt').innerHTML='<tr><th></th><th>t° від</th><th>t° до</th><th>Вітер км/год</th><th>Опади мм/год</th></tr>'+
    Object.entries(PROFILES).map(([k,v])=>`<tr><td>${v.n}</td>`+F.map(([f,l,st])=>`<td><input type="number" step="${st}" data-k="${k}" data-f="${f}" value="${v[f]}" aria-label="${v.n}: ${l}"></td>`).join('')+'</tr>').join('');
}
$('#pt').oninput=e=>{
  const i=e.target;if(!i.dataset.k)return;
  const n=parseFloat(i.value);if(!isFinite(n))return;
  PROFILES[i.dataset.k][i.dataset.f]=n;saveProf();renderCal();renderDay();
};
$('#rs').onclick=()=>{
  for(const k in DEF)Object.assign(PROFILES[k],DEF[k]);
  localStorage.removeItem('wp_prof');renderProf();render();
};
renderProf();
['lat','lon','url','key','furl','fkey','fperson'].forEach(k=>$('#'+k).value=cfg[k]);
$('#fl').onclick=async()=>{
  const fs=$('#fs');fs.className='';
  if(!(cfg.furl&&cfg.fkey)){fs.className='bad';fs.textContent='Спершу вкажи URL і ключ дошки та натисни «Зберегти».';return}
  fs.textContent='Входжу…';
  await famLoad();
  if(!fsb){fs.className='bad';fs.textContent=famState.msg||'Клієнт дошки не створено.';return}
  const {error}=await fsb.auth.signInWithPassword({email:$('#femail').value.trim(),password:$('#fpass').value});
  if(error){fs.className='bad';fs.textContent='Не вдалося увійти: '+error.message;return}
  $('#fpass').value='';
  await famLoad();renderDay();
  if(famState.mode==='ok'){fs.className='ok';fs.textContent=`Увійшов. Відкритих задач для «${cfg.fperson}»: ${famTasks.length}.`}
  else{fs.className='bad';fs.textContent='Увійшов, але задачі не завантажились: '+famState.msg}
};
$('#fo').onclick=async()=>{
  if(fsb)await fsb.auth.signOut();
  await famLoad();renderDay();
  $('#fs').className='';$('#fs').textContent='Вийшов з родинної дошки.';
};
$('#sv').onclick=async()=>{
  cfg={lat:+$('#lat').value||48.53,lon:+$('#lon').value||25.04,url:$('#url').value.trim(),key:$('#key').value.trim(),
    furl:$('#furl').value.trim(),fkey:$('#fkey').value.trim(),fperson:$('#fperson').value.trim()||'Олександр'};
  localStorage.wp_cfg=JSON.stringify(cfg);
  const ss=$('#ss');ss.className='';ss.textContent='Зберігаю і перевіряю підключення…';
  await init();
  const loc=JSON.parse(localStorage.wp_tasks||'[]').length,m=dbState.mode;
  if(m==='sb'){
    ss.className='ok';
    ss.textContent=`Збережено. Supabase підключено, справ у базі: ${tasks.length}.`+(loc?` У браузері лишилось ${loc} локальних справ, у базу вони не перенесені.`:'');
  }else if(m==='err'){
    ss.className='bad';
    ss.textContent=`Налаштування збережено, але база недоступна: ${dbState.msg}. Працюю локально.`;
  }else{
    ss.textContent='Збережено. URL або ключ Supabase не вказано, справи лишаються в цьому браузері.';
  }
  ss.textContent+=famInfo();
};

async function init(){
  sb=(cfg.url&&cfg.key&&window.supabase)?supabase.createClient(cfg.url,cfg.key):null;
  await Promise.all([loadWeather(),dbLoad(),famLoad()]);
  await metaLoad();
  $('#upd').textContent=Object.keys(H).length?'Оновлено '+new Date().toLocaleTimeString('uk-UA',{hour:'2-digit',minute:'2-digit'}):'Прогноз не завантажено';
  render();
}
setTheme(document.documentElement.dataset.theme);
render();init();
</script>
</body>
</html>
